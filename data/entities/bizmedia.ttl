# Bizmedia
# Matična datoteka entiteta; veze su u data/cases/alo-media-system.ttl.
# Entity home file; connections are in data/cases/alo-media-system.ttl.

rs:Bizmedia a :Company ;
    foaf:name "Bizmedia"@sr ;
    rdfs:comment "Beogradska kompanija za izdavanje novina u vlasništvu Alo Media System, prema CompanyWall-u i Novoj."@sr ;
    rdfs:comment "Belgrade newspaper publishing company owned by Alo Media System, according to CompanyWall and Nova."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.companywall.rs/firma/bizmedia-doo-beograd/MMx3lKQZD> ; :hasDocumentType vip:registryRecord ; :hasDocumentStatus vip:published ;
          rdfs:comment "CompanyWall: 'Vlasnik kompanije je Alo media system doo Beograd'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://nova.rs/vesti/biznis/vlasnici-aloa-i-informera-vlasnici-skoro-25-medija-u-srbiji> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Nova, odeljak Mediji u vlasništvu Alo Media Sistema: 'Bizmedia'."@sr ] .
