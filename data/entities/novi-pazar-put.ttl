rs:Novi_Pazar_Put a :Company ;
    foaf:name "Novi Pazar-put"@sr, "Novi Pazar-put"@en ;
    rdfs:comment "Građevinsko preduzeće koje RSE i Forbes Srbija opisuju kao firmu u sastavu Inkopa."@sr ;
    rdfs:comment "Construction company described by RFE/RL and Forbes Srbija as a subsidiary of Inkop."@en ;
    :hasDocumentation
        [ a :Documentation ;
          :hasDocumentURL <https://www.slobodnaevropa.org/a/zvonko-veselinovic-firme-srbija-putevi-kamenolom-novi-pazar/33752862.html> ;
          :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "RSE, 11. maj 2026: '\"Novi Pazar-put\" je, kao nekada državna građevinska firma specijalizovana za izgradnju puteva, od 2020. godine u vlasništvu \"Inkopa\", odnosno braće Zvonka i Žarka Veselinovića.'"@sr ;
          rdfs:comment "RFE/RL, 11 May 2026: '\"Novi Pazar-put\" je, kao nekada državna građevinska firma specijalizovana za izgradnju puteva, od 2020. godine u vlasništvu \"Inkopa\", odnosno braće Zvonka i Žarka Veselinovića.'"@en ] ,
        [ a :Documentation ;
          :hasDocumentURL <https://forbes.n1info.rs/biznis/kako-su-poslovali-inkop-i-druge-firme-zvonka-veselinovica-u-2024-braci-bliskoj-sns-u-slabije-su-cvetale-ruze/> ;
          :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Forbes Srbija, 14. maj 2025: 'I dobit firme Novi Pazar put, koja posluje kao zavisno preduzeće u sastavu Inkopa, poslovalo je prošle godine lošije u odnosu na 2023.'"@sr ;
          rdfs:comment "Forbes Srbija, 14 May 2025: 'I dobit firme Novi Pazar put, koja posluje kao zavisno preduzeće u sastavu Inkopa, poslovalo je prošle godine lošije u odnosu na 2023.'"@en ] .
