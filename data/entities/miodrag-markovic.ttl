rs:Miodrag_Markovic a foaf:Person ;
    foaf:firstName "Miodrag" ;
    :firstLastName "Marković" ;
    foaf:name "Miodrag Marković"@sr, "Miodrag Marković"@en ;
    rdfs:comment "Zamenik glavnog javnog tužioca Višeg javnog tužilaštva u Beogradu, prema Nova.rs i Vremenu. Reč je o beogradskom tužiocu."@sr ;
    rdfs:comment "Deputy chief public prosecutor of the Higher Public Prosecutor’s Office in Belgrade, according to Nova.rs and Vreme. This is the Belgrade prosecutor."@en ;
    :hasDocumentation
        [ a :Documentation ;
          :hasDocumentURL <https://nova.rs/vesti/hronika/nova-baza-stefanovicev-covek-za-specijalne-operacije-tuzilac-zbog-kog-je-radoicic-izbegao-pritvor-ko-u-srbiji-deli-pravdu-3-deo/> ;
          :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Nova.rs, Ivan Milićević, 18. jun 2025: 'Kao prvi zamenik glavnog tužioca beogradskog Višeg javnog tužilaštva (VJT) Nenada Stefanovića'. Citirano za funkciju Miodraga Markovića."@sr ;
          rdfs:comment "Nova.rs, Ivan Milićević, 18 June 2025: 'Kao prvi zamenik glavnog tužioca beogradskog Višeg javnog tužilaštva (VJT) Nenada Stefanovića'. Cited for Miodrag Marković’s office."@en ] ,
        [ a :Documentation ;
          :hasDocumentURL <https://vreme.com/vesti/vrhovno-javno-tuzilastvo-nenad-stefanovic-vise-javno-tuzilastvo/> ;
          :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vreme, izveštaj o nalazima komisije od 10. novembra 2026: 'zamenik glavnog tužioca Miodrag Marković'. Citirano za funkciju, ne za zaključke komisije."@sr ;
          rdfs:comment "Vreme, report on the commission findings of 10 November 2026: 'zamenik glavnog tužioca Miodrag Marković'. Cited for the office, rather than the commission’s conclusions."@en ] .
