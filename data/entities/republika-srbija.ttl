rs:Republika_Srbija a :GovernmentOrganization ;
    foaf:name "Republika Srbija"@sr, "Republic of Serbia"@en ;
    rdfs:comment "Država kao pravno lice i ugovorna strana u projektu Generalštaba, prema Radaru i Vremenu. Ovaj entitet nije Vlada niti geografska lokacija."@sr ;
    rdfs:comment "The state as a legal person and contracting party in the Generalštab project, according to Radar and Vreme. This entity is distinct from the Government and from a geographical location."@en ;
    :hasDocumentation
        [ a :Documentation ;
          :hasDocumentURL <https://radar.nova.rs/ekonomija/generalstab-ugovor-kusnera-i-vlade-srbije/> ;
          :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Radar, 13. novembar 2025, uvid u Investicioni ugovor: 'Firma Atlantic Incubation Partners LLC'; 'Republika Srbija u maju 2024. sklopili su Investicioni ugovor'"@sr ;
          rdfs:comment "Radar, 13 November 2025, examination of the investment agreement: 'Firma Atlantic Incubation Partners LLC'; 'Republika Srbija u maju 2024. sklopili su Investicioni ugovor'"@en ] ,
        [ a :Documentation ;
          :hasDocumentURL <https://vreme.com/vesti/generalstab-raskid-ugovor-dzared-kusner-srbija-penali/> ;
          :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vreme, 14. novembar 2026: 'Država Srbija zvanično je raskinula ugovor sa firmom Atlantic Incubation Partners LLC'; 'Ugovor o izgradnji hotela, kockarnice i stambenog kompleksa na mestu Generalštaba potpisao je u maju 2024. tadašnji ministar građevinarstva Goran Vesić'."@sr ;
          rdfs:comment "Vreme, 14 November 2026: 'Država Srbija zvanično je raskinula ugovor sa firmom Atlantic Incubation Partners LLC'; 'Ugovor o izgradnji hotela, kockarnice i stambenog kompleksa na mestu Generalštaba potpisao je u maju 2024. tadašnji ministar građevinarstva Goran Vesić'."@en ] .
