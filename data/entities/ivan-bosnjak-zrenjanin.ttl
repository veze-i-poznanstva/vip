rs:Ivan_Bosnjak_Zrenjanin a foaf:Person ;
    foaf:name "Ivan Bošnjak (Zrenjanin)"@sr ;
    vip:wikipediaArticle <https://en.wikipedia.org/wiki/Ivan_Bo%C5%A1njak_(politician)> ;
    foaf:firstName "Ivan" ;
    :firstLastName "Bošnjak" ;
    dbo:birthDate "1974-11-04"^^xsd:date ;
    dbo:birthPlace "Melenci, Zrenjanin, Srbija"@sr ;
    rdfs:comment "Političar Srpske napredne stranke, gradonačelnik Zrenjanina 2012-2014, državni sekretar u ministarstvu državne uprave i lokalne samouprave 2014-2020, a od 2022. u ministarstvu za ljudska i manjinska prava i društveni dijalog. Nije isto lice kao privrednik Ivan Bošnjak (rođen 1980. u Beogradu), suvlasnik Milenijum tima."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/akter/ivan-bosnjak/> ; :hasDocumentType vip:factCheckProfile ; :hasDocumentStatus vip:published ;
          rdfs:comment "Datum rođenja 4. 11. 1974, stranka SNS, mesto Zrenjanin."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://en.wikipedia.org/wiki/Ivan_Bo%C5%A1njak_(politician)> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Rođen 4. novembra 1974. u Melencima; funkcije sa datumima; Milenijum tim se ne pominje."@sr ] .
