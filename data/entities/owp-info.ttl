# OWP Info
# Matična datoteka entiteta; veze su u data/cases/alo-media-system.ttl.
# Entity home file; connections are in data/cases/alo-media-system.ttl.

rs:OWP_Info a :Company ;
    foaf:name "OWP Info"@sr ;
    rdfs:comment "Beogradska kompanija za veb portale, povezana sa portalom Objektiv.rs prema Novoj; CompanyWall navodi Alo Media System i Boška Milosavljevića kao suvlasnike."@sr ;
    rdfs:comment "Belgrade web portal company associated with Objektiv.rs according to Nova; CompanyWall lists Alo Media System and Boško Milosavljević as co-owners."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.companywall.rs/firma/owp-info/MMxI9WKCC> ; :hasDocumentType vip:registryRecord ; :hasDocumentStatus vip:published ;
          rdfs:comment "CompanyWall: 'Trenutni vlasnici kompanije su Alo media system doo Beograd, Boško Milosavljević'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://nova.rs/vesti/biznis/vlasnici-aloa-i-informera-vlasnici-skoro-25-medija-u-srbiji> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Nova, Owp info: 'ostalih 85 je u vlasništvu Alo Media Sistema', uz Milosavljevićevih 15%."@sr ] .
