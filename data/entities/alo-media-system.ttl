# Alo media system
# Matična datoteka entiteta: tip, imena, identifikatori i izvori koji potvrđuju identitet.
# Home file of this entity: type, names, identifiers and the sources for its identity.
# Veze se nalaze u data/cases/. Connections live in data/cases/.

rs:Alo_Media_System a :Company ;
    foaf:name "Alo media system"@sr ;
    :alias "Alo media system doo Beograd"@sr, "Dnevne novine Alo"@sr ;
    dbo:foundationDate "2017-03-27"^^xsd:date ;
    dbo:industry "Izdavanje novina"@sr ;
    dbo:location "Beograd, Srbija"@sr ;
    rdfs:comment "Izdavač tabloida Alo!. Osnovana u martu 2017. pod imenom Dnevne novine Alo, preimenovana u Alo media system u junu 2019; matični broj 21276081, sedište Kosovska 26, Beograd. Od kraja 2025. kupuje lokalne televizije, radio i portale, između ostalog preko firme Best Media Team, registrovane 24. decembra 2025, u kojoj od februara 2026. ima 90%, a Insajder Tim 10%. Sa Bojanom Avramovićem poseduje i firmu INI media."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://safejournalists.net/sr/vlasnik-tabloida-alo-za-manje-od-mesec-dana-kupio-dve-televizije-i-radio-za-skoro-200-000-evra/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Raskrikavanje/SafeJournalists, januar 2026: vlasnik tabloida Alo kupio dve televizije i radio."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://vreme.com/vesti/lokalni-mediji-kupovina-alo-informer/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vreme, 13. mart 2026: Alo Media System zajedno sa Bojanom Avramovićem poseduje i firmu INI media."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.021.rs/info/srbija/436227/informer-postao-suvlasnik-firme-koja-kupuje-lokalne-medije> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "021.rs, 26. februar 2026: vlasnici Best Media Team su Alo Media System 90 odsto i Insajder Tim 10 odsto; registrovana 24. decembra."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.companywall.rs/firma/alo-media-system/MMfsPqfD> ; :hasDocumentType vip:registryRecord ; :hasDocumentStatus vip:published ;
          rdfs:comment "Registarski podaci (APR preko CompanyWall): puni naziv, matični broj 21276081, PIB 109964527, osnovana 27.3.2017, Kosovska 26/3, direktor Dragan Lazić."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://serbia.mom-gmr.org/sr/mediji/detail/outlet/alo/> ; :hasDocumentType vip:registryRecord ; :hasDocumentStatus vip:published ;
          rdfs:comment "Media Ownership Monitor Srbija: 'Kompanija Alo media system osnovana je u martu 2017. pod imenom Dnevne novine Alo', preimenovana u junu 2019."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://anem.org.rs/en/strane/cilj-je-zastrasivanje-na-lokalu-i-spaljena-zemlja-kakvu-ulogu-imaju-ispostave-klonovi-informera-i-aloa> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "ANEM, 2026: 'The publisher of the newspaper Alo is Alo Media System Belgrade', povezana sa devet preduzeća (tri sestrinska, šest zavisnih)."@sr ] .
