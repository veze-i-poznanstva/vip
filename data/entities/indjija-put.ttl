rs:Indjija_Put a :Company ;
    foaf:name "JP Inđija put"@sr, "JP Inđija put"@en ;
    rdfs:comment "Javno preduzeće za upravljanje putevima i parkiralištima u Inđiji. Opštinska biografija i Beta koju prenosi Insajder navode Marka Gašića kao ranijeg direktora."@sr ;
    rdfs:comment "Public enterprise managing roads and parking in Inđija. The municipal biography and Beta, reproduced by Insajder, identify Marko Gašić as a former director."@en ;
    :hasDocumentation
        [ a :Documentation ;
          :hasDocumentURL <https://www.indjija.rs/Page.aspx?id=4> ;
          :hasDocumentType vip:webPage ; :hasDocumentStatus vip:published ;
          rdfs:comment "Opština Inđija, biografija (pročitano 15. novembra 2026): 'Marko Gašić Predsednik opštine'; '2021.godine imenovan je za direktora Javnog preduzeća za upravljanje putevima i parkiralištima „Inđija put“ Inđija.'"@sr ;
          rdfs:comment "Municipality of Inđija, biography (read 15 November 2026): 'Marko Gašić Predsednik opštine'; '2021.godine imenovan je za direktora Javnog preduzeća za upravljanje putevima i parkiralištima „Inđija put“ Inđija.'"@en ] ,
        [ a :Documentation ;
          :hasDocumentURL <https://insajder.net/prenosimo/pritvor-i-zabrana-prilaska-za-preostalo-troje-uhapsenih-s-predsednikom-opstine-indija> ;
          :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Insajder prenosi Betu, 10. novembar 2026: 'predsednik Opštine Inđija Marko Gašić'; 'Gašić i Trifunović - bivši i sadašnji direktor \"Inđija puta\"'."@sr ;
          rdfs:comment "Insajder reproduces Beta, 10 November 2026: 'predsednik Opštine Inđija Marko Gašić'; 'Gašić i Trifunović - bivši i sadašnji direktor \"Inđija puta\"'."@en ] .
