# MV Investment
# Matična datoteka entiteta: tip, imena, identifikatori i izvori koji potvrđuju identitet.
# Home file of this entity: type, names, identifiers and the sources for its identity.
# Veze se nalaze u data/cases/. Connections live in data/cases/.

rs:MV_Investment a :Company ;
    foaf:name "MV Investment"@sr ;
    dbo:industry "Upravljanje nekretninama"@sr ;
    :subsidiaryCompanyOf rs:Milenijum_Tim ;
    rdfs:comment "MV Investment je filijala Milenijum tima, vlasnik kompleksa Hotela Jugoslavija i aktivna u upravljanju nekretninama."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.danas.rs/vesti/ekonomija/sta-sve-ima-milenijum-tim-novi-vlasnik-hotela-jugoslavija/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ] ,
        [ a :Documentation ; :hasDocumentURL <https://forbes.n1info.rs/vesti/vlasnici-milenijum-tima-kupili-hotel-jugoslavija/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.danas.rs/vesti/ekonomija/milenijum-timhotel-jugoslavija/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ] ,
        [ a :Documentation ; :hasDocumentURL <https://24sedam.rs/biznis/privreda/290129/mv-investment-kupio-hotel-jugoslavija/vest> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ] ,
        [ a :Documentation ; :hasDocumentURL <https://rs.bloombergadria.com/ekonomija/srbija/55076/milenijum-tim-kupio-hotel-jugoslaviju-i-najavio-400-miliona-evra-ulaganja/news> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.companywall.rs/firma/mv-investment-doo-beograd/MVksppYq> ; :hasDocumentType vip:registryRecord ; :hasDocumentStatus vip:removed ] .
