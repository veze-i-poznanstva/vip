# Entity home file; connections are in data/cases/alo-media-system.ttl.

rs:INI_Media a :Company ;
    foaf:name "INI Media"@sr ;
    rdfs:comment "Niška medijska kompanija, izdavač Niš TV i istoimenog portala. Vreme i Danas navode Alo Media System i Bojana Avramovića kao suvlasnike."@sr ;
    rdfs:comment "Niš media company publishing Niš TV and its website. Vreme and Danas identify Alo Media System and Bojan Avramović as co-owners."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://vreme.com/vesti/lokalni-mediji-kupovina-alo-informer/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vreme: 'Alo Media System' zajedno sa Bojanom Avramovićem poseduje i firmu INI media."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.danas.rs/vesti/drustvo/idu-izbori-vise-od-pola-novca-na-niskom-konkursu-dobili-mediji-bivsih-funkcionera-sns-i-clanova-njihovih-porodica/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Danas, osnivači Ini medie: 'Alo media sistem' iz Beograda, sa ulogom od 51 odsto; Avramović ima 49%."@sr ] .
