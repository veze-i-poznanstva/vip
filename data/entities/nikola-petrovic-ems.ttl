# Nikola Petrović (EMS)
# Matična datoteka entiteta; veze su u data/cases/pandorini-papiri.ttl.
# Entity home file; connections are in data/cases/pandorini-papiri.ttl.

rs:Nikola_Petrovic_EMS a foaf:Person ;
    foaf:name "Nikola Petrović (EMS)"@sr ;
    foaf:firstName "Nikola" ;
    :firstLastName "Petrović" ;
    :alias "Nikola Petrović"@sr ;
    rdfs:comment "Bivši direktor Elektromreže Srbije i privrednik, identifikovan u KRIK-ovom istraživanju Pandorini papiri kao vlasnik Arkshore International od 2016. KRIK i RSE navode da nije odgovorio na pitanja o toj kompaniji."@sr ;
    rdfs:comment "Former director of Elektromreža Srbije and businessman, identified in KRIK’s Pandora Papers investigation as the owner of Arkshore International from 2016. KRIK and RFE/RL report that he did not answer their questions about the company."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.krik.rs/barka-predsednikovog-kuma-petrovic-sakrio-ofsor-firmu-i-racun-u-svajcarskoj/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "KRIK identifikuje 'Nikola Petrović' kao vlasnika Arkshore International i tadašnjeg direktora EMS-a."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.slobodnaevropa.org/a/krik-petrovic-pandora-papers/31493609.html> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "RSE prenosi KRIK-ovo otkriće o 'Nikola Petrović', bivšem direktoru Elektromreže Srbije, i ofšor kompaniji Arkshore International."@sr ] .
