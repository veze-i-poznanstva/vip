# Arkshore International Ltd
# Matična datoteka entiteta; veze su u data/cases/pandorini-papiri.ttl.
# Entity home file; connections are in data/cases/pandorini-papiri.ttl.

rs:Arkshore_International a :Company ;
    foaf:name "Arkshore International Ltd"@sr ;
    rdfs:comment "Ofšor kompanija sa Britanskih Devičanskih Ostrva. KRIK i RSE su 2021. izvestili o vlasništvu Nikole Petrovića; KRIK navodi početak vlasništva 2016. Kompanija je prema tadašnjim registarskim podacima neaktivna od novembra 2019, što ne određuje datum prestanka vlasništva."@sr ;
    rdfs:comment "British Virgin Islands offshore company. KRIK and RFE/RL reported Nikola Petrović’s ownership in 2021; KRIK dates its beginning to 2016. Registry information cited then described the company as inactive since November 2019, which does not establish when ownership ended."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.krik.rs/barka-predsednikovog-kuma-petrovic-sakrio-ofsor-firmu-i-racun-u-svajcarskoj/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "KRIK: 'Arkshore International LTD'; kompanija sa Britanskih Devičanskih Ostrva, neaktivna od novembra 2019. prema izveštaju iz 2021."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.slobodnaevropa.org/a/krik-petrovic-pandora-papers/31493609.html> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "RSE prenosi KRIK: 'Arkshore International' sa Britanskih Devičanskih Ostrva; neaktivna od novembra 2019. prema tadašnjem registru."@sr ] .
