    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://radar.nova.rs/ekonomija/investicioni-fond-nedic-tatjana-vukic/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Radar, 11. decembar 2025: 'rođena braća najviših državnih funkcionera'; 'predsednice parlamenta i bivše premijerke Ane Brnabić'; 'Rekorder među funkcionerskom braćom je, ipak, Igor Brnabić'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://n1info.rs/vesti/poreski-raj-za-naprednjake-smislili-su-svoje-ostrvo-usred-srbije-jeste-li-culi-za-investicioni-fond-vista-rika/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "N1, 11. decembar 2025, prenosi Radar (nije nezavisna potvrda): 'List Radar otkriva da su na spisku klijenata rođena braća najviših državnih funkcionera.'; 'Rekorder među funkcionerskom braćom, ipak je Igor Brnabić'; urednik Radara Milan Ćulibrk: 'brat Siniše Malog i brat Ane Brnabić'."@sr ] .
