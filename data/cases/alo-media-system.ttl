rs:AloMediaSystem_BestMediaTeam_Initial a vip:OwnershipConnection ;
    vip:owner rs:Alo_Media_System ;
    vip:ownedCompany rs:Best_Media_Team ;
    vip:ownershipShare 100.0 ;
    :connectionStartDate "2025-12-24"^^xsd:date ;
    :connectionEndDate "2026-02"^^xsd:gYearMonth ;
    rdfs:comment "Prema Raskrikavanju i ANEM-u, Best Media Team je osnovan u stoprocentnom vlasništvu Alo Media System. U februaru 2026. udeo je smanjen na 90%; izvori se razlikuju u danu objavljivanja promene, pa je kraj naveden na nivou meseca."@sr ;
    rdfs:comment "Raskrikavanje and ANEM report Best Media Team was initially wholly owned by Alo Media System. The stake fell to 90% in February 2026; reports differ on the day of the change, so the end date has month precision."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://raskrikavanje.rs/vlasnik-tabloida-alo-za-manje-od-mesec-dana-kupio-dve-televizije-i-radio-za-skoro-200-000-evra/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Raskrikavanje: 'u stoprocentnom vlasništvu Alo Media System-a'; kompanija je osnovana 24. decembra 2025."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://anem.org.rs/sr/strane/informer-postao-suvlasnik-cerke-firme-aloa-koja-kupuje-lokalne-medije-o-srbiji> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "ANEM, februar 2026: 'bila je u stopostotnom vlasništvu kompanije Alo Media System', pre ulaska Insajder Tima."@sr ] .

