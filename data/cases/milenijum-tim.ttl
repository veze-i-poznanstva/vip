rs:MilenijumTim_PredragMali_Automobil a :Connection ;
    bio:participant rs:Milenijum_Tim, rs:Predrag_Mali ;
    rdfs:label "Ustupljen automobil"@sr, "Car provided"@en ;
    :connectionStartDate "2014"^^xsd:gYear ;
    rdfs:comment "Prema KRIK-u (22. jul 2019), Predrag Mali već pet godina vozi „audi a6“ u vlasništvu firmi Ivana Bošnjaka i Stojana Vujka: najpre Milenijum tima, što pokazuje policijski zapisnik od 26. decembra 2014, a zatim je automobil preregistrovan na njihovu drugu firmu KBV Datacom (rs:KBV_Datacom). Novinari su ga videli u istom automobilu 5. juna 2019. Mali je rekao da „to nije tačno“; Milenijum tim: „U potpunosti odbacujemo navode da smo bilo šta ustupili ili poklonili Predragu Malom, s kojim kompanija nema nikakve odnose.“ Na sudu je 22. januara 2026. Bošnjak rekao da je Predrag Mali zaposlen u KBV Datacom-u i da „koristi samo službeni automobil koji mu pripada uz radno mesto“ (Nova.rs); to zaposlenje je zabeleženo u predrag-mali-milenijum-tim.ttl. Početak je godina najranijeg zapisa; datum preregistracije nije naveden, pa kraj nije zabeležen."@sr ;
    rdfs:comment "Per KRIK (22 July 2019), Predrag Mali had for five years driven an Audi A6 owned by Ivan Bošnjak's and Stojan Vujko's firms: first Milenijum Tim, as a police record of 26 December 2014 shows, then re-registered to their other firm KBV Datacom (rs:KBV_Datacom). Reporters saw him in the same car on 5 June 2019. Mali said it was not true; Milenijum Tim rejected the claim entirely and said it has no relations with him. In court on 22 January 2026 Bošnjak said that Predrag Mali is employed at KBV Datacom and uses only a company car that comes with the job (Nova.rs); that employment is recorded in predrag-mali-milenijum-tim.ttl. The start is the year of the earliest record; the re-registration date is not given, so no end is recorded."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.krik.rs/koruptivne-veze-milenijum-tim-ustupio-audi-i-stan-bratu-sinise-malog/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "KRIK, 22. jul 2019: 'Predrag Mali, rođeni brat ministra finansija Siniše Malog, već pet godina vozi „audi“ u vlasništvu firmi srpskih biznismena Ivana Bošnjaka i Stojana Vujka'; 'Automobil je najpre bio u vlasništvu njihove poznate firme „Milenijum tim“'; zapisnik od '26. decembra 2014'; odgovor firme: 'U potpunosti odbacujemo navode da smo bilo šta ustupili ili poklonili Predragu Malom'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://n1info.rs/vesti/a501712-Milenijum-tim-ustupio-audi-i-stan-bratu-Sinise-Malog/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "N1 (Beta, KRIK), 22. jul 2019: 'Predrag Mali već pet godina vozi \"audi\" u vlasništvu firmi srpskih biznismena Ivana Bošnjaka i Stojana Vujka, objavio je KRIK'; 'Automobil je najpre bio u vlasništvu njihove poznate firme \"Milenijum tim\"'; prenosi KRIK, nije nezavisna potvrda."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://nova.rs/vesti/politika/brat-sinise-malog-zaposlen-u-firmi-vlasnika-milenijum-tima-radi-tamo-duze-od-10-godina/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Nova.rs, 26. januar 2026, Bošnjak na ročištu 22. januara: 'Predrag koristi samo službeni automobil koji mu pripada uz radno mesto'; 'KRIK je 2019. godine otkrio i da Predrag Mali, rođeni brat ministra finansija Siniše Malog, godinama vozi „audi“ u vlasništvu firme „KBV datakom“, čiji su suvlasnici upravo Bošnjak i Vujko.'"@sr ] .

rs:MilenijumTim_PredragMali_Stan a :Connection ;
    bio:participant rs:Milenijum_Tim, rs:Predrag_Mali ;
    rdfs:label "Ustupljen stan"@sr, "Flat provided"@en ;
    :connectionEndDate "2016"^^xsd:gYear ;
    rdfs:comment "Prema KRIK-u (22. jul 2019), u dupleksu na Voždovcu u vlasništvu „ćerke firme“ Milenijum tima, koju članak ne imenuje, do 2016. stanovala je tadašnja devojka Predraga Malog; KRIK to naziva stanom ustupljenim Predragu Malom. Milenijum tim: zgrada je građena 2009, svi stanovi su prodati i nemaju evidenciju ko u njima stanuje. Bošnjak na sudu 22. januara 2026: Predrag „nikada nije koristio službeni stan, niti kompanija poseduje stanove“ (Nova.rs). Početak nije naveden."@sr ;
    rdfs:comment "Per KRIK (22 July 2019), a duplex in Voždovac owned by a Milenijum Tim subsidiary, unnamed in the article, housed Predrag Mali's then girlfriend until 2016; KRIK calls it a flat provided to Predrag Mali. Milenijum Tim said the building was built in 2009, all flats were sold and it keeps no record of who lives there. Bošnjak in court on 22 January 2026: Predrag never used a company flat, nor does the company own flats (Nova.rs). No start is given."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.krik.rs/koruptivne-veze-milenijum-tim-ustupio-audi-i-stan-bratu-sinise-malog/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "KRIK, 22. jul 2019: 'U dupleksu na Voždovcu, koji se nalazio u vlasništvu „ćerke firme“ „Milenijum tima“, do 2016. godine stanovala je tadašnja devojka Predraga Malog'; odgovor firme: 'Zgrada o kojoj govorite građena je 2009. godine, svi stanovi su prodati i nemamo evidenciju ko u njima stanuje.'"@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://n1info.rs/vesti/a501712-Milenijum-tim-ustupio-audi-i-stan-bratu-Sinise-Malog/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "N1 (Beta, KRIK), 22. jul 2019, naslov 'Milenijum tim ustupio audi i stan bratu Siniše Malog': 'biznismeni su ustupili i stan'; prenosi KRIK, nije nezavisna potvrda."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://nova.rs/vesti/politika/brat-sinise-malog-zaposlen-u-firmi-vlasnika-milenijum-tima-radi-tamo-duze-od-10-godina/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Nova.rs, 26. januar 2026, Bošnjak na ročištu 22. januara: 'a nikada nije koristio službeni stan, niti kompanija poseduje stanove'."@sr ] .