rs:IvanBosnjak_NALED a :WorkConnection ;
    bio:participant rs:Ivan_Bosnjak_Milenijum_Tim ;
    :hasEconomicOrganizationParticipant rs:NALED ;
    :hasWorkRole vip:executiveBoardMember ;
    rdfs:comment "Ivan Bošnjak, suvlasnik Milenijum tima, bio je član Izvršnog odbora NALED-a. Period nije poznat, osim da je članstvo završeno pre jula 2019. Izvor je jedan: Nova.rs preuzima navod KRIK-a."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.krik.rs/koruptivne-veze-milenijum-tim-ustupio-audi-i-stan-bratu-sinise-malog/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "KRIK, 22. jul 2019: Bošnjak je bio član Izvršnog odbora NALED-a i sa Vujkom sedi u upravi Sportskog društva Crvena zvezda."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://nova.rs/vesti/hronika/suvlasnik-milenijum-tima-bosnjak-zakupac-plantaze-u-leskovcu/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Nova.rs, 28. januar 2021: ista rečenica o suvlasniku Milenijum tima; nije nezavisna potvrda KRIK-a."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://naled.rs/htdocs/Files/15388/II-Kvartalni-izvestaj_2024.pdf> ; :hasDocumentType vip:officialDocument ; :hasDocumentStatus vip:removed ;
          rdfs:comment "Povučeno 1. novembra 2026: izveštaj navodi imenjaka, državnog sekretara, među predstavnicima ministarstva; ne potkrepljuje ovu vezu."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.uzmiracun.rs/vest-otvorene-wifi-zone-u-titelu-i-bakom-petrovcu-1345> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:removed ;
          rdfs:comment "Povučeno 1. novembra 2026: članak navodi imenjaka kao državnog sekretara, a menadžer za razvoj članstva u NALED-u je Višnja Račić. Raniji navod o toj ulozi bio je pogrešan."@sr ] .

