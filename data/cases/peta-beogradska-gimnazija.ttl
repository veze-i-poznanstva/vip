# Slučaj: Peta beogradska gimnazija — razred koji je stigao do vlade
# Case: Fifth Belgrade Gymnasium — the class that reached the government
#
# Obuhvata: Sinišu Malog, Anu Brnabić, Mihaila Jovanovića i Sašu Blagojevića, njihovu
# zajedničku školu, dalje obrazovanje i članstvo u Srpskoj naprednoj stranci.
# Osobe i organizacije su deklarisane u data/entities/, ovde su samo veze među njima.
# People and organisations are declared in data/entities/; this file holds only the connections.
# Konvencije zapisa: videti docs/data-guide.sr.md (see docs/data-guide.md).

rs:SinisaMali_SNS a :PoliticalConnection ;
    :personParticipant rs:Sinisa_Mali ;
    :politicalParticipant rs:SNS ;
    :connectionStartDate "2014"^^xsd:gYear ;
    rdfs:comment "Siniša Mali je član Srpske napredne stranke od 2014. prema infokutiji Vikipedije, potpredsednik stranke od novembra 2021. prema Istinomeru. Godina učlanjenja ima samo taj jedan izvor."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://sr.wikipedia.org/wiki/Синиша_Мали> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Infokutija Vikipedije o Siniši Malom, rubrika Politička karijera: 'Странка СНС (2014—данас)'; uvod: 'Члан је Српске напредне странке (СНС).'"@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/akter/sinisa-mali/> ; :hasDocumentType vip:factCheckProfile ; :hasDocumentStatus vip:published ;
          rdfs:comment "Istinomer, profil aktera: 'U novembru 2021. na Skupštini SNS izabran je za potpredsednika stranke.'"@sr ] .

rs:AnaBrnabic_SNS a :PoliticalConnection ;
    :personParticipant rs:Ana_Brnabic ;
    :politicalParticipant rs:SNS ;
    :connectionStartDate "2019-10"^^xsd:gYearMonth ;
    rdfs:comment "Ana Brnabić je članica Srpske napredne stranke od oktobra 2019, potpredsednica stranke od novembra 2021."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://sr.wikipedia.org/wiki/Ана_Брнабић> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vikipedija: 'Изабрана је као нестраначка политичарка, док је 2019. приступила владајућој Српској напредној странци (СНС), а потом је 2021. изабрана за потпредседницу СНС.' Mesec učlanjenja ovaj članak ne navodi."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/akter/ana-brnabic/> ; :hasDocumentType vip:factCheckProfile ; :hasDocumentStatus vip:published ;
          rdfs:comment "Istinomer, profil aktera: 'Postala je članica Srpske napredne stranke početkom oktobra 2019. godine.' i 'U novembru 2021. na Skupštini SNS izabrana je za potpredsednicu partije.'"@sr ] .

rs:SinisaMali_PetaGimnazija a :AlumniEducationalConnection ;
    :hasStudent rs:Sinisa_Mali ;
    :hasAcademicOrganization rs:Peta_Beogradska_Gimnazija ;
    :connectionStartDate "1987"^^xsd:gYear ;
    :connectionEndDate "1991"^^xsd:gYear ;
    rdfs:comment "Generacija je došla u školu 1987, prema Siniši Malom, i završila je 1991, prema razrednoj Divni Jovanović, oboje u članku lista Alo."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://sr.wikipedia.org/wiki/Синиша_Мали> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vikipedija: 'Синиша Мали рођен је у Београду, 25. августа 1972. године, где је и завршио основну школу и Пету београдску гимназију.' Godine ne navodi."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.alo.rs/vesti/politika/2184894/ekskluzivno-ekipa-alo-sa-ministrima-i-njihovom-razrednom-u-petoj-beogradskoj-posle-30-godina-sinisa-i-mihailo-od-skolskih-do-ministarskih-klupa-video.html> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Alo, 31. decembar 2022, Siniša Mali: 'veliki broj mojih drugara i drugarica je iz te škole došao u Petu beogradsku gimnaziju 1987.' Završetak: razredna Divna Jovanović: 'Oni su završili 1991. godine i posle toga nikad nije bila generacija takvih kvalitetnih đaka i odeljenja.'"@sr ] .

rs:SinisaMali_EkonomskiFakultet a :AlumniEducationalConnection ;
    :hasStudent rs:Sinisa_Mali ;
    :hasAcademicOrganization rs:Ekonomski_fakultet_University_of_Belgrade ;
    :connectionEndDate "1998"^^xsd:gYear ;
    rdfs:comment "Diplomirao i magistrirao na Ekonomskom fakultetu; magistratura 1998. Godina upisa nije zabeležena."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://sr.wikipedia.org/wiki/Синиша_Мали> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vikipedija: 'Дипломирао је на Економском факултету Универзитета у Београду, након чега је и магистрирао 1998. године на тему Трговинске изложбе као инструмент промоције предузећа на истом факултету.' Navod magistrature nema izvor u samom članku."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/akter/sinisa-mali/> ; :hasDocumentType vip:factCheckProfile ; :hasDocumentStatus vip:published ;
          rdfs:comment "Istinomer, profil aktera: 'Diplomirao je i magistrirao na Ekonomskom fakultetu Univerziteta u Beogradu, smer marketing, na temu „Trgovinske izložbe kao instrument promocije preduzeća“.' Godinu magistrature Istinomer ne navodi."@sr ] .

rs:AnaBrnabic_PetaGimnazija a :AlumniEducationalConnection ;
    :hasStudent rs:Ana_Brnabic ;
    :hasAcademicOrganization rs:Peta_Beogradska_Gimnazija ;
    :connectionEndDate "1994"^^xsd:gYear ;
    rdfs:comment "Završila Petu beogradsku gimnaziju 1994. Godina upisa nije zabeležena."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://sr.wikipedia.org/wiki/Ана_Брнабић> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vikipedija: 'Брнабићева је одрасла у Београду, где је похађала престижну Пету београдску гимназију.' Godinu završetka ne navodi."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/akter/ana-brnabic/> ; :hasDocumentType vip:factCheckProfile ; :hasDocumentStatus vip:published ;
          rdfs:comment "Istinomer, profil aktera: 'Završila je Petu beogradsku gimnaziju 1994. godine.'"@sr ] .

rs:AnaBrnabic_Northwood a :AlumniEducationalConnection ;
    :hasStudent rs:Ana_Brnabic ;
    :hasAcademicOrganization rs:Northwood_University_Michigan ;
    :connectionEndDate "1998"^^xsd:gYear ;
    rdfs:comment "Završila studije poslovne administracije na Univerzitetu Northwood 1998. Godina upisa nije zabeležena."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://sr.wikipedia.org/wiki/Ана_Брнабић> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vikipedija: 'Поред српског образовања, Брнабићева има и диплому пословне администрације на Универзитету Нортвуд и мастер пословне администрације Универзитета у Халу' Godinu ne navodi."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/akter/ana-brnabic/> ; :hasDocumentType vip:factCheckProfile ; :hasDocumentStatus vip:published ;
          rdfs:comment "Istinomer, profil aktera: 'Na univerzitetu Northwood u Mičigenu završila je studije poslovne administracije 1998. godine'"@sr ] .

rs:MihailoJovanovic_PetaGimnazija a :AlumniEducationalConnection ;
    :hasStudent rs:Mihailo_Jovanovic ;
    :hasAcademicOrganization rs:Peta_Beogradska_Gimnazija ;
    :connectionStartDate "1987"^^xsd:gYear ;
    :connectionEndDate "1991"^^xsd:gYear ;
    rdfs:comment "Isto odeljenje kao Siniša Mali, prema članku lista Alo; generacija je došla u školu 1987, prema Siniši Malom, i završila je 1991, prema razrednoj Divni Jovanović."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://www.alo.rs/vesti/politika/2184894/ekskluzivno-ekipa-alo-sa-ministrima-i-njihovom-razrednom-u-petoj-beogradskoj-posle-30-godina-sinisa-i-mihailo-od-skolskih-do-ministarskih-klupa-video.html> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Alo, 31. decembar 2022: 'Pogađate, u pitanju su Siniša Mali i Mihailo Jovanović.' i razredna Divna Jovanović: 'Oni su završili 1991. godine'; Siniša Mali: 'veliki broj mojih drugara i drugarica je iz te škole došao u Petu beogradsku gimnaziju 1987.'"@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.youtube.com/watch?v=tHgNZtQdGrg&t=5s> ; :hasDocumentType vip:videoRecording ; :hasDocumentStatus vip:published ;
          rdfs:comment "YouTube, kanal ALO. RS, naslov snimka: 'SINIŠA MALI I MIHAILO JOVANOVIĆ OD ŠKOLSKIH DO MINISTARSKIH KLUPA - Bivšu razrednu iznenadili cvećem'. Sam snimak nije pregledan; stranica ne navodi godine školovanja."@sr ] .

# Saša Blagojević: školovanje i isto odeljenje sa Sinišom Malim.
# Saša Blagojević: school attendance and the same class as Siniša Mali.
# Izvori navode kraj osamdesetih; tačne godine školovanja nisu poznate.
# Sources say the late 1980s; exact attendance years are unknown.

rs:SasaBlagojevic_PetaGimnazija a :AlumniEducationalConnection ;
    :hasStudent rs:Sasa_Blagojevic ;
    :hasAcademicOrganization rs:Peta_Beogradska_Gimnazija ;
    rdfs:comment "Saša Blagojević je pohađao Petu beogradsku gimnaziju u istom odeljenju kao Siniša Mali, prema Pištaljci, Istinomeru, Danasu, Novoj i Vremenu. Pištaljka navodi kraj osamdesetih; tačne godine školovanja nisu navedene. Ostali članci prenose ili pripisuju navod Pištaljci ili ranijem medijskom izveštavanju."@sr ;
    rdfs:comment "Saša Blagojević attended Peta beogradska gimnazija in the same class as Siniša Mali, according to Pištaljka, Istinomer, Danas, Nova and Vreme. Pištaljka places this in the late 1980s; exact attendance years are not stated. The other articles repeat or attribute the account to Pištaljka or earlier media reporting."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://pistaljka.rs/home/read/724> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Pištaljka, 8. maj 2018, o Blagojeviću i Malom: 'крајем осамдесетих ишли су у исто одељење Пете београдске гимназије'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/analize/medijska-koalicija-jednog-ministra-u-zgradi-novosti/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Istinomer prenosi Pištaljku o Blagojeviću i Malom: 'krajem osamdesetih išli su u isto odeljenje Pete beogradske gimnazije'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.danas.rs/vesti/ekonomija/sasa-blagojevic-alo-rock-radio-mediji-lik-dana/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Danas, o Blagojeviću i Malom: 'isto odeljenje u Petu beogradsku gimnaziju'. Članak pripisuje navod Pištaljci, ali greškom povezuje /723; odgovarajući izvor je /724."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://nova.rs/vesti/biznis/vlasnici-aloa-i-informera-vlasnici-skoro-25-medija-u-srbiji> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Nova, o Blagojeviću i Malom, prema pisanju medija: 'isto odeljenje u Petu beogradsku gimnaziju'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://vreme.com/vreme/prica-se-prica-o-prodaji-blica/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vreme prenosi Pištaljkin navod o Blagojeviću i Malom: 'isto odeljenje u Petoj beogradskoj gimnaziji'."@sr ] .

rs:SasaBlagojevic_SinisaMali_Classmates a :Classmate ;
    bio:participant rs:Sasa_Blagojevic, rs:Sinisa_Mali ;
    :connectedVia rs:Peta_Beogradska_Gimnazija ;
    rdfs:comment "Saša Blagojević i Siniša Mali bili su u istom odeljenju Pete beogradske gimnazije krajem osamdesetih, prema Pištaljci i kasnijim izveštajima. Tačne godine nisu navedene; navod o istom odeljenju nije izveden samo iz pohađanja iste škole."@sr ;
    rdfs:comment "Saša Blagojević and Siniša Mali were in the same class at Peta beogradska gimnazija in the late 1980s, according to Pištaljka and subsequent reporting. Exact years are not stated; the same-class claim is explicit, rather than inferred from attending the same school."@en ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://pistaljka.rs/home/read/724> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Pištaljka, 8. maj 2018, o Blagojeviću i Malom: 'крајем осамдесетих ишли су у исто одељење Пете београдске гимназије'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/analize/medijska-koalicija-jednog-ministra-u-zgradi-novosti/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Istinomer prenosi Pištaljku o Blagojeviću i Malom: 'krajem osamdesetih išli su u isto odeljenje Pete beogradske gimnazije'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.danas.rs/vesti/ekonomija/sasa-blagojevic-alo-rock-radio-mediji-lik-dana/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Danas, o Blagojeviću i Malom: 'isto odeljenje u Petu beogradsku gimnaziju'. Članak pripisuje navod Pištaljci, ali greškom povezuje /723; odgovarajući izvor je /724."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://nova.rs/vesti/biznis/vlasnici-aloa-i-informera-vlasnici-skoro-25-medija-u-srbiji> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Nova, o Blagojeviću i Malom, prema pisanju medija: 'isto odeljenje u Petu beogradsku gimnaziju'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://vreme.com/vreme/prica-se-prica-o-prodaji-blica/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Vreme prenosi Pištaljkin navod o Blagojeviću i Malom: 'isto odeljenje u Petoj beogradskoj gimnaziji'."@sr ] ,
        [ a :Documentation ; :hasDocumentURL <https://raskrikavanje.rs/milo-irinej-jaja-i-paradajz-ili-kako-alo-vadi-sopstvene-fleke/> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ;
          rdfs:comment "Raskrikavanje prenosi Pištaljku o Blagojeviću i Malom: 'krajem osamdesetih su išli u isto odeljenje gimnazije'. Ovaj pasus ne navodi naziv škole."@sr ] .
