# Slučaj: Peta beogradska gimnazija — razred koji je stigao do vlade
# Case: Fifth Belgrade Gymnasium — the class that reached the government
#
# Obuhvata: Sinišu Malog, Anu Brnabić, Mihaila Jovanovića i Sašu Blagojevića, njihovu
# zajedničku školu, dalje obrazovanje i članstvo u Srpskoj naprednoj stranci.
# Osobe i organizacije su deklarisane u data/entities/, ovde su samo veze među njima.
# People and organisations are declared in data/entities/; this file holds only the connections.
# Konvencije zapisa: videti docs/data-guide.sr.md (see docs/data-guide.md).

rs:SinisaMali_SNS a :PoliticalConnection ;
    :personParticipant rs:Sinisa_Mali ;
    :politicalParticipant rs:SNS ;
    :connectionStartDate "2014"^^xsd:gYear ;
    rdfs:comment "Siniša Mali je član Srpske napredne stranke od 2014. prema infokutiji Vikipedije, potpredsednik stranke od novembra 2021. prema Istinomeru. Godina učlanjenja ima samo taj jedan izvor."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://sr.wikipedia.org/wiki/Синиша_Мали> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/akter/sinisa-mali/> ; :hasDocumentType vip:factCheckProfile ; :hasDocumentStatus vip:published ] .

rs:AnaBrnabic_SNS a :PoliticalConnection ;
    :personParticipant rs:Ana_Brnabic ;
    :politicalParticipant rs:SNS ;
    :connectionStartDate "2019-10"^^xsd:gYearMonth ;
    rdfs:comment "Ana Brnabić je članica Srpske napredne stranke od oktobra 2019, potpredsednica stranke od novembra 2021."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://sr.wikipedia.org/wiki/Ана_Брнабић> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.istinomer.rs/akter/ana-brnabic/> ; :hasDocumentType vip:factCheckProfile ; :hasDocumentStatus vip:published ] .

rs:SinisaMali_PetaGimnazija a :AlumniEducationalConnection ;
    :hasStudent rs:Sinisa_Mali ;
    :hasAcademicOrganization rs:Peta_Beogradska_Gimnazija ;
    :connectionStartDate "1987"^^xsd:gYear ;
    :connectionEndDate "1991"^^xsd:gYear ;
    rdfs:comment "Generacija je došla u školu 1987. i završila je 1991, prema razrednoj u članku lista Alo."@sr ;
    :hasDocumentation
        [ a :Documentation ; :hasDocumentURL <https://sr.wikipedia.org/wiki/Синиша_Мали> ; :hasDocumentType vip:encyclopediaArticle ; :hasDocumentStatus vip:published ] ,
        [ a :Documentation ; :hasDocumentURL <https://www.alo.rs/vesti/politika/2184894/ekskluzivno-ekipa-alo-sa-ministrima-i-njihovom-razrednom-u-petoj-beogradskoj-posle-30-godina-sinisa-i-mihailo-od-skolskih-do-ministarskih-klupa-video.html> ; :hasDocumentType vip:newsArticle ; :hasDocumentStatus vip:published ] .

