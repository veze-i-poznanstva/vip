rs:AndrejVucic_KKCrvenaZvezda
        rdf:type              :WorkConnection , :SourcedEntity , :Connection , bio:Relationship;
        rdfs:comment          "Member of the Presidency of KK Crvena zvezda: elected at the first regular assembly session of 2014 (club notice archived on 30 January 2014) with a mandate to 12 August 2016; resigned by the second regular assembly session (notice archived on 30 June 2014). Vreme (1 October 2014) writes that this was his only formal public position and that he left the management \"this summer\". The months follow from those facts."@en , "Član Predsedništva KK Crvena zvezda: izabran na prvoj redovnoj sednici Skupštine 2014 (obaveštenje kluba arhivirano 30. januara 2014) sa mandatom do 12. avgusta 2016; ostavku podneo pre druge redovne sednice Skupštine (obaveštenje arhivirano 30. juna 2014). Vreme (1. oktobar 2014) piše da je to bila njegova jedina formalna javna funkcija i da je upravu napustio „ovog leta“. Meseci su izvedeni iz tih podataka."@sr;
        :connectionEndDate    "2014-06"^^xsd:gYearMonth;
        :connectionStartDate  "2014-01"^^xsd:gYearMonth;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "KK Crvena zvezda, obaveštenje 'Podrška trenerima, promene u rukovodstvu' (arhivirano 30. juna 2014): 'ostavke su podneli i članovi Predsedništva: Andrej Vučić, Aleksandar Jokić i Ognjen Oliverić'."@sr;
                                :hasDocumentStatus  vip:archived;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <http://www.kkcrvenazvezda.rs/index.php/article/podrska-trenerima-promene-u-rukovodstvu>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Vreme, 1. oktobar 2014 (Slobodan Georgijev): 'po dolasku naprednjaka na vlast 2012. godine, Andrej Vučić je formalno imao samo tu „javnu funkciju“, dakle u upravi kluba koji se nekad zvao FMP'; 'Andrej zajedno sa Malim napustio ovog leta upravu kluba'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://vreme.com/vreme/u-senci-velikog-brata/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "KK Crvena zvezda, obaveštenje 'Održana Skupština KK Crvena zvezda' (arhivirano 30. januara 2014): 'dobio 19 novih članova Skupštine, koji su potom izglasali i trojicu članova Predsedništva. To su: Andrej Vučić, Aleksandar Jokić i Ognjen Oliverić.'; 'Mandat članova Skupštine i Predsedništva traje do 12. avgusta 2016. godine.'"@sr;
                                :hasDocumentStatus  vip:archived;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <http://www.kkcrvenazvezda.rs/index.php/article/odrzana-skupstina-kk-crvena-zvezda>
                              ];
        :hasEconomicOrganizationParticipant
                rs:KK_Crvena_Zvezda;
        :hasWorkRole          vip:presidencyMember;
        bio:participant       rs:KK_Crvena_Zvezda , rs:Andrej_Vucic;
        owl:differentFrom     rs:Andrej_Vucic , rs:KK_Crvena_Zvezda .

