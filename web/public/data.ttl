rs:PredragMali_AndrejVucic_Friendship
        rdf:type           :SourcedEntity , :Connection , :SocialConnection , :Friendship , bio:Relationship;
        rdfs:comment       "Prema rečima Siniše Malog u intervjuu hrvatskom nedeljniku Globus u proleće 2014 (novinar Darko Hudelist), kako su preneli KRIK i Danas 14. marta 2018: „Vučićev rođeni brat Andrej i moj mlađi brat Predrag (Peđa) najbolji prijatelji.“ Predrag Mali je 15. oktobra 2015. pred Višim sudom izjavio da su on i Andrej Vučić na dan Parade ponosa 2014. zajedno krenuli na porodični ručak kod Vučićevih roditelja (Beta/N1). Andrej Vučić je 4. septembra 2019. pred sudom demantovao da je predložio Malog za gradonačelnika i rekao da mu je Mali kazao da to nikada nije rekao; o prijateljstvu se nije izjašnjavao, a KRIK Predraga Malog naziva njegovim prijateljem. Sam tekst intervjua u Globusu nije dostupan onlajn. Datumi početka i prestanka nisu navedeni."@sr , "In Siniša Mali's words to the Croatian weekly Globus in spring 2014 (journalist Darko Hudelist), as quoted by KRIK and Danas on 14 March 2018: \"Vučić's own brother Andrej and my younger brother Predrag (Peđa) are best friends.\" On 15 October 2015 Predrag Mali testified in the Higher Court that he and Andrej Vučić had set off together for a family lunch at Vučić's parents' home on the 2014 Pride day (Beta/N1). On 4 September 2019 Andrej Vučić denied in court that he proposed Mali as mayor and said Mali told him he never said it; he did not address the friendship, and KRIK calls Predrag Mali his friend. The Globus text itself is not available online. No start or end dates are stated."@en;
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "KRIK, 5. septembar 2019: 'Andreja Vučića su u septembru 2014. na beogradskoj Paradi ponosa zajedno sa njegovim prijateljem Predragom Malim, bratom Siniše Malog, pretukli žandarmi.'; demanti: '„Nije mi poznato ni šta je izjavio, ni da li je izjavio. Kad sam pitao Sinišu Malog on mi je odgovorio da to nikada nije rekao“, kazao je juče Vučić.'"@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.krik.rs/andrej-vucic-nisam-neformalni-gradonacelnik-novog-sada/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "N1 (Beta), 15. oktobar 2015: 'Poput Vučića, i Mali je naveo da su zajedno krenuli na porodični ručak kod Vučićevih roditelja i da su kod Hrama Svetog Save parkirali automobil'."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://n1info.rs/vesti/a100688-predrag-mali-na-sudjenju/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Danas, 14. mart 2018 (prema KRIK-u): '„Stvar je u tome što su Vučićev rođeni brat Andrej i moj mlađi brat Predrag (Peđa) najbolji prijatelji. I ja sam uvek njima pomagao“, rekao je Mali u intervjuu za „Globus“.'; prenosi KRIK, nije nezavisna potvrda."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.danas.rs/vesti/politika/mali-postao-sam-gradonacelnik-po-ideji-andreja-vucica/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "KRIK, 14. mart 2018 (Dragana Pećo): '„Stvar je u tome što su Vučićev rođeni brat Andrej i moj mlađi brat Predrag (Peđa) najbolji prijatelji. I ja sam uvek njima pomagao“, rekao je Mali u intervjuu za „Globus“.'"@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.krik.rs/mali-postao-sam-gradonacelnik-po-ideji-andreja-vucica/>
                           ];
        bio:participant    rs:Andrej_Vucic , rs:Predrag_Mali;
        owl:differentFrom  rs:Andrej_Vucic , rs:Predrag_Mali .

