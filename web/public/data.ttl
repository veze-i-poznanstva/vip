rs:SinisaMali_VladaSrbije_MinistarFinansija
        rdf:type              :WorkConnection , :Connection , bio:Relationship , :SourcedEntity;
        rdfs:comment          "The National Assembly elected Siniša Mali finance minister on 29 May 2018, by 154 votes to 30; his term began with the oath (Danas, the Government's site). The Government's official biography, read on 10 November 2026, lists him as First Deputy Prime Minister and Minister of Finance and says he held the same offices in the term that ended in April 2025. No end is recorded: that is the latest documented state, not proof that the office continues."@en , "Narodna skupština je 29. maja 2018. izabrala Sinišu Malog za ministra finansija, sa 154 glasa za i 30 protiv; mandat mu je počeo polaganjem zakletve (Danas, sajt Vlade). Zvanična biografija Vlade, pročitana 10. novembra 2026, vodi ga kao prvog potpredsednika Vlade i ministra finansija i navodi da je iste funkcije obavljao u mandatu do aprila 2025. Kraj nije zabeležen: to je poslednje dokumentovano stanje, ne dokaz da funkcija traje."@sr;
        :connectionStartDate  "2018-05-29"^^xsd:date;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Danas, 29. maj 2018: 'poslanici su izabrali Sinišu Malog za novog ministra finansija u Vladi Srbije. Za izbor Malog glasala su 154 poslanika, protiv je bilo 30 poslanika'; 'Mali je pred poslanicima položio zakletvu, čime mu je počeo mandat.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.danas.rs/vesti/politika/sinisa-mali-novi-ministar-finansija/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Zvanična biografija, naslov 'Први потпредседник Владе и министар финансија': 'Од 2018. године је министар финансија у Влади Републике Србије, а од 2022. године и потпредседник Владе. Исте функције обављао је у мандату до априла 2025. године.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <https://www.srbija.gov.rs/biografija/67114/sinisa-mali.php>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Sajt Vlade, 'Belgrade, 29 May 2018': 'The National Assembly of the Republic of Serbia today supported with 154 votes the proposal of Prime Minister Ana Brnabic and elected Sinisa Mali as new Minister of Finance, who up until now has served as mayor of Belgrade.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.srbija.gov.rs/vest/en/128256/sinisa-mali-appointed-new-finance-minister.php>
                              ];
        :hasEconomicOrganizationParticipant
                rs:Vlada_Srbije;
        :hasWorkRole          vip:minister;
        bio:participant       rs:Sinisa_Mali , rs:Vlada_Srbije;
        owl:differentFrom     rs:Vlada_Srbije , rs:Sinisa_Mali .

