rs:SasaBlagojevic_PetaGimnazija
        rdf:type                  :EducationalConnection , bio:Relationship , :AlumniEducationalConnection , :SourcedEntity , :Connection;
        rdfs:comment              "Saša Blagojević attended Peta beogradska gimnazija in the same class as Siniša Mali, according to Pištaljka, Istinomer, Danas, Nova and Vreme. Pištaljka places this in the late 1980s; exact attendance years are not stated. The other articles repeat or attribute the account to Pištaljka or earlier media reporting."@en , "Saša Blagojević je pohađao Petu beogradsku gimnaziju u istom odeljenju kao Siniša Mali, prema Pištaljci, Istinomeru, Danasu, Novoj i Vremenu. Pištaljka navodi kraj osamdesetih; tačne godine školovanja nisu navedene. Ostali članci prenose ili pripisuju navod Pištaljci ili ranijem medijskom izveštavanju."@sr;
        :hasAcademicOrganization  rs:Peta_Beogradska_Gimnazija;
        :hasDocumentation         [ rdf:type            :RelatedData , :Documentation;
                                    rdfs:comment        "Nova, o Blagojeviću i Malom, prema pisanju medija: 'isto odeljenje u Petu beogradsku gimnaziju'."@sr;
                                    :hasDocumentStatus  vip:published;
                                    :hasDocumentType    vip:newsArticle;
                                    :hasDocumentURL     <https://nova.rs/vesti/biznis/vlasnici-aloa-i-informera-vlasnici-skoro-25-medija-u-srbiji>
                                  ];
        :hasDocumentation         [ rdf:type            :RelatedData , :Documentation;
                                    rdfs:comment        "Istinomer prenosi Pištaljku o Blagojeviću i Malom: 'krajem osamdesetih išli su u isto odeljenje Pete beogradske gimnazije'."@sr;
                                    :hasDocumentStatus  vip:published;
                                    :hasDocumentType    vip:newsArticle;
                                    :hasDocumentURL     <https://www.istinomer.rs/analize/medijska-koalicija-jednog-ministra-u-zgradi-novosti/>
                                  ];
        :hasDocumentation         [ rdf:type            :RelatedData , :Documentation;
                                    rdfs:comment        "Vreme prenosi Pištaljkin navod o Blagojeviću i Malom: 'isto odeljenje u Petoj beogradskoj gimnaziji'."@sr;
                                    :hasDocumentStatus  vip:published;
                                    :hasDocumentType    vip:newsArticle;
                                    :hasDocumentURL     <https://vreme.com/vreme/prica-se-prica-o-prodaji-blica/>
                                  ];
        :hasDocumentation         [ rdf:type            :RelatedData , :Documentation;
                                    rdfs:comment        "Pištaljka, 8. maj 2018, o Blagojeviću i Malom: 'крајем осамдесетих ишли су у исто одељење Пете београдске гимназије'."@sr;
                                    :hasDocumentStatus  vip:published;
                                    :hasDocumentType    vip:newsArticle;
                                    :hasDocumentURL     <https://pistaljka.rs/home/read/724>
                                  ];
        :hasDocumentation         [ rdf:type            :RelatedData , :Documentation;
                                    rdfs:comment        "Danas, o Blagojeviću i Malom: 'isto odeljenje u Petu beogradsku gimnaziju'. Članak pripisuje navod Pištaljci, ali greškom povezuje /723; odgovarajući izvor je /724."@sr;
                                    :hasDocumentStatus  vip:published;
                                    :hasDocumentType    vip:newsArticle;
                                    :hasDocumentURL     <https://www.danas.rs/vesti/ekonomija/sasa-blagojevic-alo-rock-radio-mediji-lik-dana/>
                                  ];
        :hasStudent               rs:Sasa_Blagojevic;
        bio:participant           rs:Peta_Beogradska_Gimnazija , rs:Sasa_Blagojevic;
        owl:differentFrom         rs:Sasa_Blagojevic , rs:Peta_Beogradska_Gimnazija .

rs:MihailoJovanovic_PetaGimnazija
        rdf:type                  :AlumniEducationalConnection , :EducationalConnection , :SourcedEntity , bio:Relationship , :Connection;
        rdfs:comment              "Isto odeljenje kao Siniša Mali, prema članku lista Alo; generacija je došla u školu 1987, prema Siniši Malom, i završila je 1991, prema razrednoj Divni Jovanović."@sr;
        :connectionEndDate        "1991"^^xsd:gYear;
        :connectionStartDate      "1987"^^xsd:gYear;
        :hasAcademicOrganization  rs:Peta_Beogradska_Gimnazija;
        :hasDocumentation         [ rdf:type            :RelatedData , :Documentation;
                                    rdfs:comment        "YouTube, kanal ALO. RS, naslov snimka: 'SINIŠA MALI I MIHAILO JOVANOVIĆ OD ŠKOLSKIH DO MINISTARSKIH KLUPA - Bivšu razrednu iznenadili cvećem'. Sam snimak nije pregledan; stranica ne navodi godine školovanja."@sr;
                                    :hasDocumentStatus  vip:published;
                                    :hasDocumentType    vip:videoRecording;
                                    :hasDocumentURL     <https://www.youtube.com/watch?v=tHgNZtQdGrg&t=5s>
