rs:NovicaToncev_DarkoTamindzic_Friendship
        rdf:type           :Connection , :SocialConnection , bio:Relationship , :SourcedEntity , :Friendship;
        rdfs:comment       "Prema Tončevljevom iskazu KRIK-u, on i Darko Tamindžić su dugogodišnji prijatelji. Vijesti prenose isti iskaz; Tamindžićev odgovor preko advokata potvrđuje da Tončeva poznaje više od 20 godina. Datumi početka i prestanka prijateljstva nisu navedeni."@sr , "Tončev told KRIK that he and Darko Tamindžić were longstanding friends. Vijesti republished his statement; Tamindžić’s response through his lawyer says he had known Tončev for over 20 years. Friendship start and end dates are not stated."@en;
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Tončev za KRIK: 'S Darkom Tamindžićem sam odavno prijatelj'."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.krik.rs/firma-koje-se-niko-ne-seca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Vijesti prenose Tončevljev iskaz: 'S Darkom Tamindžićem sam odavno prijatelj'."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.vijesti.me/svijet/balkan/569829/pandorini-papiri-firma-koje-se-niko-ne-sjeca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura>
                           ];
        bio:participant    rs:Darko_Tamindzic , rs:Novica_Toncev;
        owl:differentFrom  rs:Darko_Tamindzic , rs:Novica_Toncev .

rs:SinisaMali_BrighamHoldingFinance
        rdf:type            :Connection , vip:OwnershipConnection , bio:Relationship , :SourcedEntity;
        rdfs:comment        "KRIK and OCCRP report that Pandora Papers documents identify Siniša Mali as the sole shareholder of Brigham Holding & Finance Inc. Ownership transferred to Ana Panayotova in August 2014; the acquisition date is not stated. Mali disputed ownership of the 23 apartments purchased through the two offshore companies; the report says he did not answer questions about the new documents."@en , "Prema KRIK-u i OCCRP-u, dokumenta iz Pandorinih papira identifikuju Sinišu Malog kao jedinog akcionara kompanije Brigham Holding & Finance Inc. Vlasništvo je preneto na Anu Panajotovu u avgustu 2014; tačan datum sticanja nije naveden. Mali je osporavao vlasništvo nad 23 apartmana koja su kupljena preko dve ofšor firme; prema izveštaju, nije odgovorio na pitanja o novim dokumentima."@sr;
        :connectionEndDate  "2014-08"^^xsd:gYearMonth;
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "OCCRP navodi Malog kao 'sole shareholder' Brigham Holding & Finance Inc.; prenos vlasništva dve BVI firme: 'in August 2014'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://www.occrp.org/en/project/the-pandora-papers/despite-denials-serbian-finance-minister-owned-luxury-apartments-after-all>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "KRIK identifikuje Brigham Holding & Finance Inc. i navodi da je Mali bio 'i vlasnik ovih kompanija'; prenos vlasništva: 'U avgustu 2014'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://www.krik.rs/nova-dokumenta-sa-devicanskih-ostrva-mali-je-definitivno-bio-vlasnik-24-stana/>
                            ];
        bio:participant     rs:Sinisa_Mali , rs:Brigham_Holding_Finance;
        owl:differentFrom   rs:Brigham_Holding_Finance , rs:Sinisa_Mali;
        vip:ownedCompany    rs:Brigham_Holding_Finance;
        vip:owner           rs:Sinisa_Mali;
        vip:ownershipShare  100.0 .

rs:MihailoJovanovic_KancelarijaIT_Direktor
        rdf:type              :Connection , :WorkConnection , bio:Relationship , :SourcedEntity;
        rdfs:comment          "Mihailo Jovanović je postao direktor Kancelarije kada je osnovana 2017. (sajt Kancelarije). Novosti navode da je bio na njenom čelu do decembra 2022, a ministar je postao 26. oktobra 2022 (zapis u vlada-srbije.ttl); zato je kraj zabeležen samo kao godina. Mesec početka sajt Kancelarije ne navodi."@sr , "Mihailo Jovanović became director of the Office when it was founded in 2017 (the Office's site). Novosti says he led it until December 2022, while he became a minister on 26 October 2022 (the record in vlada-srbije.ttl); the end is therefore recorded as the year only. The Office's site gives no month for the start."@en;
        :connectionEndDate    "2022"^^xsd:gYear;
        :connectionStartDate  "2017"^^xsd:gYear;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Novosti, 29. avgust 2024: 'od 2017. godine do decembra 2022. godine je već bio na čelu Kancelarije'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.novosti.rs/vesti/politika/1403964/predlog-premijera-vucevica-mihailo-jovanovic-novi-direktor-kancelarije-eupravu>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Sajt Kancelarije, strana 'Direktor' (pročitano 12. novembra 2026): 'Kancelarije za informacione tehnologije i elektronsku upravu Vlade Republike Srbije 2017. godine, kada je postao i njen direktor'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <https://www.ite.gov.rs/tekst/sr/150/direktor.php>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Danas, 26. septembar 2020: 'reagovao je direktor Kancelarije, Mihailo Jovanović'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.danas.rs/vesti/ekonomija/ugovori-aseka-s-18-miliona-evra-skocili-na-16-miliona/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Radio Slobodna Evropa, 23. septembar 2020: 'Direktor Vladine Kancelarije za IT Mihajlo Jovanović'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.slobodnaevropa.org/a/tepić-firma-premijerkinog-brata-iz-budžeta-dobila-40-miliona-evra/30854137.html>
                              ];
        :hasEconomicOrganizationParticipant
                rs:Kancelarija_za_IT_i_eUpravu;
        :hasWorkRole          :director;
        bio:participant       rs:Mihailo_Jovanovic , rs:Kancelarija_za_IT_i_eUpravu;
        owl:differentFrom     rs:Kancelarija_za_IT_i_eUpravu , rs:Mihailo_Jovanovic .

