rs:NovicaToncev_ServiceForEfficientEnergy
        rdf:type              :SourcedEntity , bio:Relationship , vip:OwnershipConnection , :Connection;
        rdfs:comment          "Prema KRIK-u i BIRN-u, Novica Tončev osnovao je Service for Efficient Energy 2010. i bio njen vlasnik. Tončev je prvo negirao vlasništvo, zatim ga priznao uz tvrdnju da firma nije poslovala. KRIK navodi da je nije prijavio Agenciji. Udeo i datum prestanka njegovog vlasništva nisu utvrđeni; gašenje kompanije 2020. nije dokaz da ju je posedovao do tada."@sr , "KRIK and BIRN report Novica Tončev established Service for Efficient Energy in 2010 and owned it. He first denied ownership, then acknowledged it while saying the company never traded. KRIK reports he did not declare it to the Agency. His share and ownership end date are unknown; dissolution in 2020 does not prove he held it until then."@en;
        :connectionStartDate  "2010"^^xsd:gYear;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "KRIK za Tončeva: 'setio da je bio vlasnik kompanije'; osnivanje datira u 2010. Prenosi njegovu tvrdnju da firma nije poslovala."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.krik.rs/firma-koje-se-niko-ne-seca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "BIRN, 7. oktobar 2021: 'Toncev opened a company called “Service for Efficient Energy“'; navodi osnivanje 2010. i njegovo naknadno priznanje vlasništva."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://balkaninsight.com/2021/10/07/pandora-papers-reveal-second-serbian-ministers-hidden-offshore/>
                              ];
        bio:participant       rs:Novica_Toncev , rs:Service_for_Efficient_Energy;
        owl:differentFrom     rs:Novica_Toncev , rs:Service_for_Efficient_Energy;
        vip:ownedCompany      rs:Service_for_Efficient_Energy;
        vip:owner             rs:Novica_Toncev .

