        vip:owner          rs:Nenad_Ignjatovic_Deko_Tim .

rs:StojanVujko_KBVDatacom
        rdf:type            :Connection , :SourcedEntity , vip:OwnershipConnection , bio:Relationship;
        rdfs:comment        "Stojan Vujko is a co-owner of KBV Datacom: Ivan Bošnjak said in court on 22 January 2026 that he and Vujko are \"minority owners\" of the firm (Nova.rs); KRIK wrote in 2019 that the firm is \"majority-owned by the same businessmen, Bošnjak and Vujko\". Per the registry (APR via CompanyWall, read 10 November 2026) the share is 30%, alongside Dragan Kilibarda 30%, Miloš Janjić 5% and Rade Sekulić 5%; the acquisition date is not stated."@en , "Stojan Vujko je suvlasnik KBV Datacom-a: Ivan Bošnjak je na sudu 22. januara 2026. rekao da su on i Vujko „manjinski vlasnici“ te firme (Nova.rs); KRIK je 2019. pisao da je firma „u većinskom vlasništvu istih biznismena – Bošnjaka i Vujka“. Prema registru (APR preko CompanyWall, očitano 10. novembra 2026) udeo je 30%, uz Dragana Kilibardu 30%, Miloša Janjića 5% i Rade Sekulića 5%; datum sticanja nije naveden."@sr;
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Nova.rs, 26. januar 2026, Bošnjak na sudu: 'Ta kompanija nije ćerka firme “Milenijum tima”, ali smo Stojan Vujko i ja manjinski vlasnici iste.'"@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://nova.rs/vesti/politika/brat-sinise-malog-zaposlen-u-firmi-vlasnika-milenijum-tima-radi-tamo-duze-od-10-godina/>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Registarski podaci (APR preko CompanyWall, očitano 10. novembra 2026): vlasnici 'Dragan Kilibarda(30,00%)', 'Ivan Bošnjak(30,00%)', 'Miloš Janjić(5,00%)', 'Rade Sekulić(5,00%)', 'Stojan Vujko(30,00%)'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:registryRecord;
                              :hasDocumentURL     <https://www.companywall.rs/firma/kbv-datacom-doo-beograd/MMu9ivZ0>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "KRIK, 22. jul 2019: 'preregistrovan na „KBV datakom“ (KBV datacom), firmu takođe u većinskom vlasništvu istih biznismena – Bošnjaka i Vujka'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://www.krik.rs/koruptivne-veze-milenijum-tim-ustupio-audi-i-stan-bratu-sinise-malog/>
                            ];
        bio:participant     rs:Stojan_Vujko , rs:KBV_Datacom;
        owl:differentFrom   rs:Stojan_Vujko , rs:KBV_Datacom;
        vip:ownedCompany    rs:KBV_Datacom;
        vip:owner           rs:Stojan_Vujko;
        vip:ownershipShare  30.0 .

