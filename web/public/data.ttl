rs:Srecko_Kostov_Surdulica
        rdf:type           foaf:Agent , foaf:Person;
        rdfs:comment       "Surduličanin i saradnik Darka Tamindžića, prema KRIK-u i Vijestima; naveden kao svedok u dokumentima o osnivanju Tončevljeve ofšor firme. Kostov je novinarima rekao da poznaje Tončeva, ali je negirao vezu sa firmom. Izvori ga ne predstavljaju kao političara."@sr , "Surdulica associate of Darko Tamindžić, according to KRIK and Vijesti; identified as a witness in the formation documents of Tončev’s offshore company. Kostov told reporters he knew Tončev but denied involvement with the company. The sources do not identify him as a politician."@en;
        :alias             "Srećko Kostov"@sr;
        :firstLastName     "Kostov";
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "KRIK navodi da je Srećko Kostov bio 'svedok Tončevu' i potpisao osnivačka dokumenta. Kostov je negirao vezu sa firmom."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.krik.rs/firma-koje-se-niko-ne-seca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Vijesti prenose KRIK: Srećko Kostov bio je 'svedok Tončevu'; u istom članku preneta je Kostovljeva negacija veze sa firmom."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.vijesti.me/svijet/balkan/569829/pandorini-papiri-firma-koje-se-niko-ne-sjeca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura>
                           ];
        skos:altLabel      "Srećko Kostov"@sr;
        foaf:familyName    "Kostov";
        foaf:firstName     "Srećko";
        foaf:name          "Srećko Kostov (Surdulica)"@sr , "Srećko Kostov"@sr .

rs:Starting  rdf:type      foaf:Organization , foaf:Agent , :Company;
