                                    :hasDocumentStatus  vip:published;
                                    :hasDocumentType    vip:newsArticle;
                                    :hasDocumentURL     <https://www.alo.rs/vesti/politika/2184894/ekskluzivno-ekipa-alo-sa-ministrima-i-njihovom-razrednom-u-petoj-beogradskoj-posle-30-godina-sinisa-i-mihailo-od-skolskih-do-ministarskih-klupa-video.html>
