rs:PredragMali_KKCrvenaZvezda
        rdf:type              :WorkConnection , :SourcedEntity , bio:Relationship , :Connection;
        rdfs:comment          "Član Upravnog odbora KK Crvena zvezda: izabran na trećoj sednici Predsedništva u 2014, održanoj posle prve redovne sednice Skupštine (obaveštenje kluba, arhivirano 30. januara 2014), sa mandatom od godinu dana; ostavku podneo pre druge redovne sednice Skupštine, na kojoj je podnet i sportski izveštaj za sezonu 2013/2014 (obaveštenje arhivirano 30. juna 2014). Vreme (1. oktobar 2014) piše da ga je Andrej Vučić doveo u upravu i da su je obojica napustili „ovog leta“. Meseci su izvedeni iz tih podataka; tačni dani sednica nisu navedeni."@sr , "Member of the board of KK Crvena zvezda: elected at the Presidency's third session of 2014, held after the first regular assembly session (club notice, archived on 30 January 2014), with a one-year mandate; resigned by the second regular assembly session, which also received the sports report for the 2013/2014 season (notice archived on 30 June 2014). Vreme (1 October 2014) writes that Andrej Vučić brought him into the management and that both left it \"this summer\". The months follow from those facts; the exact session dates are not stated."@en;
        :connectionEndDate    "2014-06"^^xsd:gYearMonth;
        :connectionStartDate  "2014-01"^^xsd:gYearMonth;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "KRIK, 22. jul 2019: 'Predrag Mali i Bošnjak bili su 2014. godine članovi Upravnog odbora ovog kluba, u vreme dok je Andrej Vučić bio član predsedništva.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.krik.rs/koruptivne-veze-milenijum-tim-ustupio-audi-i-stan-bratu-sinise-malog/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Vreme, 1. oktobar 2014 (Slobodan Georgijev): 'On je doveo i Predraga Malog u upravu'; 'Andrej zajedno sa Malim napustio ovog leta upravu kluba prepuštajući Čoviću sve upravljačke moći.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://vreme.com/vreme/u-senci-velikog-brata/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "KK Crvena zvezda, obaveštenje 'Održana Skupština KK Crvena zvezda' (arhivirano 30. januara 2014): 'treća sednica Predsedništva u 2014. godini na kojoj je formiran novi Upravni odbor kluba u kome se pored članova Predsedništva nalaze i: Luka Petrović, Darko Glišić, Ivan Bošnjak, Đorđe Vučinić, Branislav Baćević, Ivan Bekjarev, Veljko Gudelj, Ranko Žeravica, Nikola Vasiljević, Nemanja Lazić i Predrag Mali. Mandat svih članova Upravnog odbora traje godinu dana.' Stranica više nije na sajtu kluba."@sr;
                                :hasDocumentStatus  vip:archived;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <http://www.kkcrvenazvezda.rs/index.php/article/odrzana-skupstina-kk-crvena-zvezda>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "KK Crvena zvezda, obaveštenje 'Podrška trenerima, promene u rukovodstvu' (arhivirano 30. juna 2014): 'Druga redovna sednica Skupštine KK Crvena zvezda'; 'a promena je bilo i u Upravnom odboru pošto su ostavke podneli: Luka Petrović, Darko Glišić, Predrag Mali i Ivan Bošnjak.' Stranica više nije na sajtu kluba."@sr;
                                :hasDocumentStatus  vip:archived;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <http://www.kkcrvenazvezda.rs/index.php/article/podrska-trenerima-promene-u-rukovodstvu>
                              ];
        :hasEconomicOrganizationParticipant
                rs:KK_Crvena_Zvezda;
        :hasWorkRole          vip:boardMember;
        bio:participant       rs:Predrag_Mali , rs:KK_Crvena_Zvezda;
        owl:differentFrom     rs:KK_Crvena_Zvezda , rs:Predrag_Mali .

