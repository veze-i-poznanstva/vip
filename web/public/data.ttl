rs:AnaBrnabic_VladaSrbije_MinistarkaDrzavneUprave
        rdf:type              :WorkConnection , bio:Relationship , :Connection , :SourcedEntity;
        rdfs:comment          "Ana Brnabić je u avgustu 2016. izabrana za ministarku državne uprave i lokalne samouprave i tu funkciju je obavljala do izbora za predsednicu Vlade 29. juna 2017. (sajt Narodne skupštine, Vikipedija). Sajt Skupštine navodi mesec izbora; dan, 11. avgust 2016, navodi samo Vikipedija, pa je početak zabeležen do meseca."@sr , "Ana Brnabić was elected Minister of Public Administration and Local Self-Government in August 2016 and held the office until she was elected Prime Minister on 29 June 2017 (the National Assembly's site, Wikipedia). The Assembly's site gives the month of the election; only Wikipedia gives the day, 11 August 2016, so the start is recorded to the month."@en;
        :connectionEndDate    "2017-06-29"^^xsd:date;
        :connectionStartDate  "2016-08"^^xsd:gYearMonth;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Enciklopedijski članak: '11. август 2016 — 29. јун 2017.'; 'У августу 2016. године, именована је за министра државне управе и локалне самоуправе.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:encyclopediaArticle;
                                :hasDocumentURL     <https://sr.wikipedia.org/wiki/Ана_Брнабић>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Sajt Narodne skupštine (pročitano 12. novembra 2026): 'U avgustu 2016. godine izabrana je za ministarku državne uprave i lokalne samouprave u Vladi Srbije, i tu funkciju je obavljala do izbora za predsednicu Vlade'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <https://www.parlament.gov.rs/ANA_BRNABIĆ.1190.891.html>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "N1, 15. jun 2017: 'Dosadašnja ministarka državne uprave i lokalne samouprave Ana Brnabić biće mandatarka za sastav nove Vlade Srbije'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://n1info.rs/vesti/a276314-Ana-Brnabic-nova-premijerka/>
                              ];
        :hasEconomicOrganizationParticipant
                rs:Vlada_Srbije;
        :hasWorkRole          vip:minister;
        bio:participant       rs:Vlada_Srbije , rs:Ana_Brnabic;
        owl:differentFrom     rs:Ana_Brnabic , rs:Vlada_Srbije .

rs:Andrej_Vucic  rdf:type     foaf:Agent , foaf:Person;
        rdfs:comment          "Brother of Aleksandar Vučić; per Wikipedia a senior SNS official and formerly executive director of the National Bank's banknote and coin mint. Member of the Presidency of KK Crvena zvezda from January to June 2014. The kinship with Aleksandar Vučić is not yet recorded as a connection, because Aleksandar Vučić is not in the dataset."@en , "Brat Aleksandra Vučića; prema Vikipediji visoki funkcioner SNS i ranije izvršni direktor Zavoda za izradu novčanica i kovanog novca NBS. Član Predsedništva KK Crvena zvezda od januara do juna 2014. Srodstvo sa Aleksandrom Vučićem ovde još nije zabeleženo kao veza, jer Aleksandar Vučić nije unet u bazu."@sr;
        dbo:birthDate         "1972-04-09"^^xsd:date;
        dbo:birthPlace        "Beograd, Srbija"@sr;
        :firstLastName        "Vučić";
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Vikipedija: 'Андреј Вучић (Београд, 9. април 1972) српски је политичар и предузетник. Вучић је високи званичник Српске напредне странке, претходно је био извршни директор Завода за израду новчаница и кованог новца Народне банке Србије (НБС).'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:encyclopediaArticle;
                                :hasDocumentURL     <https://sr.wikipedia.org/wiki/Андреј_Вучић>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "KRIK, 5. septembar 2019: 'Andreja Vučića su u septembru 2014. na beogradskoj Paradi ponosa zajedno sa njegovim prijateljem Predragom Malim, bratom Siniše Malog, pretukli žandarmi.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.krik.rs/andrej-vucic-nisam-neformalni-gradonacelnik-novog-sada/>
                              ];
        foaf:familyName       "Vučić";
        foaf:firstName        "Andrej";
        foaf:name             "Andrej Vučić"@sr;
        vip:wikidataItem      <http://www.wikidata.org/entity/Q61746836>;
        vip:wikipediaArticle  <https://sr.wikipedia.org/wiki/Андреј_Вучић> .

