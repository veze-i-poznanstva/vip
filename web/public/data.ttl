rs:SinisaMali_EthamInvestFinance
        rdf:type            vip:OwnershipConnection , :SourcedEntity , :Connection , bio:Relationship;
        rdfs:comment        "Prema KRIK-u i OCCRP-u, dokumenta iz Pandorinih papira identifikuju Sinišu Malog kao jedinog akcionara kompanije Etham Invest & Finance Corp. Vlasništvo je preneto na Anu Panajotovu u avgustu 2014; tačan datum sticanja nije naveden. Mali je osporavao vlasništvo nad 23 apartmana koja su kupljena preko dve ofšor firme; prema izveštaju, nije odgovorio na pitanja o novim dokumentima."@sr , "KRIK and OCCRP report that Pandora Papers documents identify Siniša Mali as the sole shareholder of Etham Invest & Finance Corp. Ownership transferred to Ana Panayotova in August 2014; the acquisition date is not stated. Mali disputed ownership of the 23 apartments purchased through the two offshore companies; the report says he did not answer questions about the new documents."@en;
        :connectionEndDate  "2014-08"^^xsd:gYearMonth;
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "OCCRP navodi Malog kao 'sole shareholder' Etham Invest & Finance Corp.; prenos vlasništva dve BVI firme: 'in August 2014'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://www.occrp.org/en/project/the-pandora-papers/despite-denials-serbian-finance-minister-owned-luxury-apartments-after-all>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "KRIK identifikuje Etham Invest & Finance Corp. i navodi da je Mali bio 'i vlasnik ovih kompanija'; prenos vlasništva: 'U avgustu 2014'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://www.krik.rs/nova-dokumenta-sa-devicanskih-ostrva-mali-je-definitivno-bio-vlasnik-24-stana/>
                            ];
        bio:participant     rs:Etham_Invest_Finance , rs:Sinisa_Mali;
        owl:differentFrom   rs:Sinisa_Mali , rs:Etham_Invest_Finance;
        vip:ownedCompany    rs:Etham_Invest_Finance;
        vip:owner           rs:Sinisa_Mali;
        vip:ownershipShare  100.0 .

