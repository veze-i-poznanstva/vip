rs:MilanVukovljak_BobNoviSad
        rdf:type           :Connection , :SourcedEntity , vip:OwnershipConnection , bio:Relationship;
        rdfs:comment       "Vlasnik prema 021.rs (27. januar 2025) i prema Srni u Glasu Srpske (30. avgust 2021), koja navodi samo firmu „Bob“ i Novi Sad kao mesto gde on živi. Udeo i datumi nisu poznati."@sr , "Owner per 021.rs (27 January 2025) and per Srna in Glas Srpske (30 August 2021), which names only the firm \"Bob\" and Novi Sad as where he lives. Share and dates are unknown."@en;
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "021.rs, 27. januar 2025, pod naslovom 'Šta se zna o Bob doo?': 'Vlasnik je Milan Vukovljak.'"@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.021.rs/novi-sad/vesti/400000/objavljen-ugovor-startinga-sa-jos-jednim-podizvodjacem-ko-je-postavljao-staklo-na-nadstresnicu>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Glas Srpske, 30. avgust 2021 (Srna): 'Milan Vukovljak porijeklom iz Gubina, koji živi u Novom Sadu i vlasnik je firme \"Bob\"'."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.glassrpske.com/lat/novosti/drustvo/prikupljene-brojne-donacije-za-izgradnju-konaka-pri-hramu-u-selu-gubin-nadomak-livna/374914>
                           ];
        bio:participant    rs:Milan_Vukovljak , rs:Bob_Novi_Sad;
        owl:differentFrom  rs:Milan_Vukovljak , rs:Bob_Novi_Sad;
        vip:ownedCompany   rs:Bob_Novi_Sad;
        vip:owner          rs:Milan_Vukovljak .

rs:SinisaMali_GradBeograd_Gradonacelnik
        rdf:type              :WorkConnection , :SourcedEntity , :Connection , bio:Relationship;
        rdfs:comment          "Siniša Mali je izabran za gradonačelnika Beograda 24. aprila 2014. (Istinomer, Vikipedija) i tu funkciju vršio do maja 2018, kada je izabran za ministra finansija (zvanična biografija Vlade). Dan kraja, 28. maj 2018, daje Vikipedija; Vlada navodi samo mesec."@sr , "Siniša Mali was elected mayor of Belgrade on 24 April 2014 (Istinomer, Wikipedia) and held the office until May 2018, when he was elected finance minister (the Government's official biography). The end day, 28 May 2018, comes from Wikipedia; the Government gives only the month."@en;
        :connectionEndDate    "2018-05-28"^^xsd:date;
        :connectionStartDate  "2014-04-24"^^xsd:date;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Enciklopedijski članak, infokutija: 'почетак функције 24. април 2014', 'крај функције 28. мај 2018'; tekst: 'од 2014. до 2018. градоначелник Београда'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:encyclopediaArticle;
                                :hasDocumentURL     <https://sr.wikipedia.org/wiki/Синиша_Мали>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Istinomer, biografija: 'Za gradonačelnika Beograda izabran je 24. aprila 2014. godine.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:factCheckProfile;
                                :hasDocumentURL     <https://www.istinomer.rs/akter/sinisa-mali/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Zvanična biografija na sajtu Vlade: 'Пре ступања на дужност министра био је градоначелник Београда од априла 2014. до маја 2018. године.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <https://www.srbija.gov.rs/biografija/67114/sinisa-mali.php>
                              ];
        :hasEconomicOrganizationParticipant
                rs:Grad_Beograd;
        :hasWorkRole          vip:mayor;
        bio:participant       rs:Sinisa_Mali , rs:Grad_Beograd;
        owl:differentFrom     rs:Sinisa_Mali , rs:Grad_Beograd .

