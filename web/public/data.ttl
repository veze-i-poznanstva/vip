rs:Starting_HidroTehna_Stanica
        rdf:type           bio:Relationship , :Connection , :SourcedEntity;
        rdfs:comment       "Spisak dokumentacije (stavka 509) navodi ponudu br. 96 firme Hidro-tehna d.o.o. Novi Sad firmi Starting za hidroizolaciju zgrade stanice, od 29. septembra 2022, i dopunu te ponude za hidroizolaterske radove na krovu, od 8. decembra 2022; to su ponude, spisak ne navodi ugovor. Forbes Srbija (5. maj 2025) prenosi iskaz inženjera firme Starting da je hidroizolaciju radila „Hidrotehna“ kao podizvođač firme Starting. Forbes ne navodi grad, pa da je to novosadska firma zasniva se na imenu i vrsti posla. Kada su radovi počeli i završeni nije poznato."@sr , "The document index (item 509) lists offer no. 96 of Hidro-tehna d.o.o. Novi Sad to Starting for waterproofing the station building, dated 29 September 2022, and a supplement to it for waterproofing work on the roof, dated 8 December 2022; these are offers, the index lists no contract. Forbes Srbija (5 May 2025) reports the testimony of a Starting engineer that the waterproofing was done by \"Hidrotehna\" as Starting's subcontractor. Forbes names no town, so that this is the Novi Sad company rests on the name and the kind of work. When the work began and ended is unknown."@en;
        rdfs:label         "podizvođenje obnove stanice"@sr , "station renovation subcontract"@en;
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Forbes Srbija, 5. maj 2025: 'A na krovu su radile firma Starting i njen podizvođač Hidrotehna.'; 'postavljanje hidroizolacije radila Hidrotehna'."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://forbes.n1info.rs/biznis/svedoci-startinga-i-kineza-otkrili-ko-je-uklonio-betonske-kocke-sa-krova-stanice-i-zasto-ih-nema-u-gradjevinskom-dnevniku/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Spisak objavljene dokumentacije (mss.jt.rs, PDF izrađen 27. januara 2025; prema 021.rs i Vremenu, dokumentaciju je objavilo Više javno tužilaštvo u Novom Sadu), stavka 509: 'Понуда бр. 96, за израду хидроизолације објекта железничке станице у Новом Саду, од стране'; 'Хидро-техна д.о.о. Нови Сад упућена Стартинг д.о.о. Београд. Датум: 29.09.2022.'; 'Допина понуди бр. 96, за израду хидроизолатерске радове на крову железничке'; 'Београд. Датум: 08.12.2022.'"@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:officialDocument;
                             :hasDocumentURL     <https://mss.jt.rs/wp-content/uploads/2025/01/%D0%A1%D0%BF%D0%B8%D1%81%D0%B0%D0%BA-%D0%BE%D0%B1%D1%98%D0%B0%D0%B2%D1%99%D0%B5%D0%BD%D0%B5-%D0%B4%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D1%86%D0%B8%D1%98%D0%B5-1.pdf>
                           ];
        bio:participant    rs:Hidro_Tehna_Novi_Sad , rs:Starting;
        owl:differentFrom  rs:Hidro_Tehna_Novi_Sad , rs:Starting .

