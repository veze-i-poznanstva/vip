        foaf:name          "Best Media Team"@sr .

rs:KBV_Datacom  rdf:type    foaf:Agent , :Company , foaf:Organization;
        rdfs:comment        "Belgrade company designing and building telecoms, power and traffic infrastructure; more than 200 employees per its own site. Per KRIK, the company of Ivan Bošnjak and Stojan Vujko to which the Audi driven by Predrag Mali was re-registered; per the registry (APR via CompanyWall, read 10 November 2026) the owners are Dragan Kilibarda 30%, Ivan Bošnjak 30%, Stojan Vujko 30%, Miloš Janjić 5% and Rade Sekulić 5%, director Dragan Kilibarda; Kilibarda, Janjić and Sekulić are not entered here."@en , "Beogradska firma za projektovanje i izgradnju telekomunikacione, elektroenergetske i saobraćajne infrastrukture; prema sopstvenom sajtu više od 200 zaposlenih. Prema KRIK-u, firma Ivana Bošnjaka i Stojana Vujka na koju je preregistrovan audi koji vozi Predrag Mali; prema registru (APR preko CompanyWall, očitano 10. novembra 2026) vlasnici su Dragan Kilibarda 30%, Ivan Bošnjak 30%, Stojan Vujko 30%, Miloš Janjić 5% i Rade Sekulić 5%, direktor Dragan Kilibarda; Kilibarda, Janjić i Sekulić ovde nisu uneti."@sr;
        dbo:foundationDate  "2011-03-11"^^xsd:date;
        dbo:industry        "Telekomunikaciona, energetska i saobraćajna infrastruktura"@sr;
        dbo:location        "Beograd, Srbija"@sr;
        :alias              "Društvo za informacione tehnologije i telekomunikacije KBV DATACOM d.o.o. Beograd"@sr , "KBV datakom"@sr;
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Sajt firme: 'Projektujemo, gradimo i integrišemo telekomunikacione, elektroenergetske i ITS sisteme'; '200 + zaposlenih'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:webPage;
                              :hasDocumentURL     <https://kbvdatacom.rs/>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Registarski podaci (APR preko CompanyWall, očitano 10. novembra 2026): 'Naziv Društvo za informacione tehnologije i telekomunikacije KBV DATACOM d.o.o. Beograd'; 'Datum osnivanja 11.3.2011.'; vlasnici 'Dragan Kilibarda(30,00%)', 'Ivan Bošnjak(30,00%)', 'Miloš Janjić(5,00%)', 'Rade Sekulić(5,00%)', 'Stojan Vujko(30,00%)'; 'Direktor Dragan Kilibarda'; 'Delatnost 6209 - Ostale usluge informacione tehnologije'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:registryRecord;
                              :hasDocumentURL     <https://www.companywall.rs/firma/kbv-datacom-doo-beograd/MMu9ivZ0>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "KRIK, 22. jul 2019: 'preregistrovan na „KBV datakom“ (KBV datacom), firmu takođe u većinskom vlasništvu istih biznismena – Bošnjaka i Vujka'; 'Njihova druga firma „KBV datakom“ ... prekopala je širi centar Beograda kako bi postavila optičke kablove za državnu telekomunikacionu kompaniju Telekom Srbija.'"@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://www.krik.rs/koruptivne-veze-milenijum-tim-ustupio-audi-i-stan-bratu-sinise-malog/>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Nova.rs, 26. januar 2026, Bošnjak na sudu: 'Predrag Mali je između 10 i 15 godina zaposlen u kompaniji “КBV datakom”, delatnost kompanije je telekomunikacija. Ta kompanija nije ćerka firme “Milenijum tima”, ali smo Stojan Vujko i ja manjinski vlasnici iste.'"@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://nova.rs/vesti/politika/brat-sinise-malog-zaposlen-u-firmi-vlasnika-milenijum-tima-radi-tamo-duze-od-10-godina/>
                            ];
        skos:altLabel       "KBV datakom"@sr , "Društvo za informacione tehnologije i telekomunikacije KBV DATACOM d.o.o. Beograd"@sr;
        foaf:name           "KBV datakom"@sr , "Društvo za informacione tehnologije i telekomunikacije KBV DATACOM d.o.o. Beograd"@sr , "KBV Datacom d.o.o. Beograd"@sr .

rs:SrdjanDavidovic_VistaRica
        rdf:type            :Connection , :SourcedEntity , vip:OwnershipConnection , bio:Relationship;
        rdfs:comment        "Prospekt iz 2024. navodi udeo Srđana Davidovića od 25%; Nova Ekonomija izveštava da je izašao iz vlasništva, dok je udeo Vukić povećan sa 50% na 75%. Mesec promene je izveden: prospekt navodi saglasnost Komisije za hartije od vrednosti na sticanje kvalifikovanog učešća od 25. marta 2026, a Nova Ekonomija 31. marta 2026. piše da je povećanje udela objavljeno u Centralnom registru hartija od vrednosti; dan prenosa nije naveden."@sr , "The 2024 prospectus lists Srđan Davidović’s 25% stake; Nova Ekonomija reports his exit while Vukić’s stake increased from 50% to 75%. The month of the change is inferred: the prospectus lists the Securities Commission's consent to the acquisition of a qualified holding, dated 25 March 2026, and Nova Ekonomija wrote on 31 March 2026 that the increase had been published in the Central Securities Register; the day of the transfer is not stated."@en;
        :connectionEndDate  "2026-03"^^xsd:gYearMonth;
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Nova Ekonomija, 31. mart 2026: 'Iz vlasništva firme je istupio Srđan Davidović'; opisuje povećanje udela Vukić sa 50% na 75%."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://novaekonomija.rs/vesti-iz-zemlje/tatjana-vukic-po-pisanju-medija-partnerka-andreja-vucica-postala-vecinski-vlasnik-investicionog-fonda-vista-rica>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Prospekt Vista Rica Invest, ažuriran 18.09.2026, Davidovića više ne navodi; pod 'Akcionari Društva su:' stoje samo 'Tatjana Vukić, osnivač i akcionar koja poseduje kvalifikovano učešće od 75%' i 'Vojislav Nedić, osnivač i akcionar koji poseduje kvalifikovano učešće od 25%'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:officialDocument;
                              :hasDocumentURL     <https://vistarica.rs/wp-content/uploads/2026/09/Prospekt-VR-Invest-2026-final-potpisan.pdf>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Prospekt: 'Srđan Davidović, osnivač i akcionar koji poseduje kvalifikovano učešće od 25%'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:officialDocument;
                              :hasDocumentURL     <https://vistarica.rs/wp-content/uploads/2024/09/VISTA-RICA-CORPORATE_PROSPEKT_.pdf>
                            ];
        bio:participant     rs:Vista_Rica_AD , rs:Srdjan_Davidovic;
        owl:differentFrom   rs:Srdjan_Davidovic , rs:Vista_Rica_AD;
        vip:ownedCompany    rs:Vista_Rica_AD;
        vip:owner           rs:Srdjan_Davidovic;
        vip:ownershipShare  25.0 .

rs:Darko_Tamindzic  rdf:type  foaf:Agent , foaf:Person;
        rdfs:comment       "Singapore-based businessman whose links to Novica Tončev and Srećko Kostov were reported by KRIK and Vijesti in the Pandora Papers investigation. Tončev said he helped establish the offshore company; Tamindžić’s lawyer acknowledged knowing of its existence."@en , "Biznismen iz Singapura o čijim vezama sa Novicom Tončevom i Srećkom Kostovom izveštavaju KRIK i Vijesti u projektu Pandorini papiri. Prema Tončevu, pomogao mu je da osnuje ofšor firmu; Tamindžićev advokat je potvrdio da zna za postojanje firme."@sr;
        :firstLastName     "Tamindžić";
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Vijesti prenose KRIK-ov izveštaj o biznismenu 'Darko Tamindžić' i njegovoj vezi sa Tončevom i Kostovom."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.vijesti.me/svijet/balkan/569829/pandorini-papiri-firma-koje-se-niko-ne-sjeca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "KRIK: 'Darko Tamindžić'; poslovni saradnici i Tončev opisuju njegove poslove i ulogu u osnivanju kompanije."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.krik.rs/firma-koje-se-niko-ne-seca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura/>
                           ];
        foaf:familyName    "Tamindžić";
        foaf:firstName     "Darko";
        foaf:name          "Darko Tamindžić"@sr .

