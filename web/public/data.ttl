rs:IvanBosnjakZrenjanin_SNS
        rdf:type                  :AssociationConnection , :SourcedEntity , :Connection , :PoliticalConnection , bio:Relationship;
        rdfs:comment              "Ivan Bošnjak, političar iz Zrenjanina rođen 1974, član je Srpske napredne stranke prema Istinomerovoj biografiji ažuriranoj 14. januara 2015. RTV ga je 2012. opisao kao pokrajinskog poslanika SNS prilikom izbora za gradonačelnika Zrenjanina. Datumi učlanjenja i eventualnog prestanka članstva nisu navedeni u korišćenim izvorima."@sr , "Ivan Bošnjak, the Zrenjanin politician born in 1974, is identified as a Serbian Progressive Party member in Istinomer's biography updated on 14 January 2015. RTV described him as an SNS provincial assembly member when reporting his election as Zrenjanin mayor in 2012. The cited sources do not state when membership began or whether it subsequently ended."@en;
        :hasDocumentation         [ rdf:type            :RelatedData , :Documentation;
                                    rdfs:comment        "RTV, izveštaj o izboru gradonačelnika Zrenjanina: 'izabrali pokrajinskog poslanika SNS Ivana Bošnjaka (38)'."@sr;
                                    :hasDocumentStatus  vip:published;
                                    :hasDocumentType    vip:newsArticle;
                                    :hasDocumentURL     <https://rtv.rs/sr_lat/vojvodina/banat/ivan-bosnjak-novi-gradonacelnik-zrenjanina_337551.html>
                                  ];
        :hasDocumentation         [ rdf:type            :RelatedData , :Documentation;
                                    rdfs:comment        "Istinomer, biografija Ivana Bošnjaka iz Zrenjanina: 'Član je Srpske napredne stranke.' Profil je ažuriran 14. januara 2015."@sr;
                                    :hasDocumentStatus  vip:published;
                                    :hasDocumentType    vip:factCheckProfile;
                                    :hasDocumentURL     <https://www.istinomer.rs/akter/ivan-bosnjak/>
                                  ];
        :organizationParticipant  rs:SNS;
        :personParticipant        rs:Ivan_Bosnjak_Zrenjanin;
        :politicalParticipant     rs:SNS;
        bio:participant           rs:SNS , rs:Ivan_Bosnjak_Zrenjanin;
        owl:differentFrom         rs:SNS , rs:Ivan_Bosnjak_Zrenjanin .

