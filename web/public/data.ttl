rs:TatjanaVukic_VistaRica_50
        rdf:type            :SourcedEntity , vip:OwnershipConnection , :Connection , bio:Relationship;
        rdfs:comment        "The 2024 prospectus lists Tatjana Vukić as owning 50% of the management company Vista Rica AD Beograd. The month of the change is inferred: the prospectus lists the Securities Commission's consent to the acquisition of a qualified holding, dated 25 March 2026, and Nova Ekonomija wrote on 31 March 2026 that the increase had been published in the Central Securities Register; the day of the transfer is not stated."@en , "Prospekt iz 2024. navodi da Tatjana Vukić poseduje 50% društva za upravljanje Vista Rica AD Beograd. Mesec promene je izveden: prospekt navodi saglasnost Komisije za hartije od vrednosti na sticanje kvalifikovanog učešća od 25. marta 2026, a Nova Ekonomija 31. marta 2026. piše da je povećanje udela objavljeno u Centralnom registru hartija od vrednosti; dan prenosa nije naveden."@sr;
        :connectionEndDate  "2026-03"^^xsd:gYearMonth;
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Prospekt: 'Tatjana Vukić, osnivač i akcionar koji poseduje kvalifikovano učešće od 50%'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:officialDocument;
                              :hasDocumentURL     <https://vistarica.rs/wp-content/uploads/2024/09/VISTA-RICA-CORPORATE_PROSPEKT_.pdf>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Nova Ekonomija, 31. mart 2026: 'Vukić je uvećala svoj udeo u akcionarskom društvu Vista Rica sa 50 na 75 odsto, objavljeno je u Centralnom registru hartija od vrednosti.'"@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://novaekonomija.rs/vesti-iz-zemlje/tatjana-vukic-po-pisanju-medija-partnerka-andreja-vucica-postala-vecinski-vlasnik-investicionog-fonda-vista-rica>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Prospekt Vista Rica Invest, ažuriran 18.09.2026: 'Tatjana Vukić, osnivač i akcionar koja poseduje kvalifikovano učešće od 75%'; 'Rešenje Komisije o saglasnosti na sticanje kvalifikovanog učešća br. 2/5-101-2546/4-23, od dana 28.11.2023. godine i br. 2/5-103-549/5-26 od dana 25.03.2026. godine'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:officialDocument;
                              :hasDocumentURL     <https://vistarica.rs/wp-content/uploads/2026/09/Prospekt-VR-Invest-2026-final-potpisan.pdf>
                            ];
