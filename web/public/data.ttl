rs:IgorBrnabic_AssecoSEE_Direktor
        rdf:type            :SourcedEntity , bio:Relationship , :Connection , :WorkConnection;
        rdfs:comment        "Izvori opisuju Igora Brnabića kao direktora srpskog ogranka Asseco SEE ili kao jednog od njegovih direktora (Danas, Radio Slobodna Evropa, Nova.rs, Insajder). Funkciju je napustio u novembru 2020. (Nova.rs; Insajder, prenosi N1). Izvori se ne slažu o tome kada je postavljen (Danas: februar 2017; Insajder: 2015), pa početak nije zabeležen."@sr , "Sources describe Igor Brnabić as director of the Serbian branch of Asseco SEE, or as one of its directors (Danas, Radio Slobodna Evropa, Nova.rs, Insajder). He left the post in November 2020 (Nova.rs; Insajder, carried by N1). The sources do not agree on when he was appointed (Danas: February 2017; Insajder: 2015), so no start is recorded."@en;
        :connectionEndDate  "2020-11"^^xsd:gYearMonth;
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "N1, 22. decembar 2020, prenosi Insajder: 'od 2015. do 2020. bio je direktor predstavništva te kompanije u Srbiji'; 'Ostavku je podneo u novembru ove godine'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://n1info.rs/vesti/a686233-Politika-kao-biznis-drzava-kao-partijski-plen-treci-deo/>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Danas, 26. septembar 2020: 'Igor Brnabić direktor je srpskog ogranka Aseko SEE.'"@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://www.danas.rs/ljudi/igor-brnabic-prozvani-direktor-premijerkin-brat/>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Radio Slobodna Evropa, 25. septembar 2020: 'Igor Brnabić, jedan od direktora u Asseco SEE'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://www.slobodnaevropa.org/a/ana-brnabic-asseco-vlada-budzet-tender-korupcija-srbija/30857881.html>
                            ];
        :hasDocumentation   [ rdf:type            :RelatedData , :Documentation;
                              rdfs:comment        "Nova.rs, 23. novembar 2020 (stranica izmenjena 14. februara 2025): 'Igor Brnabić napustio je direktorsku funkciju u kompaniji Aseko u novembru 2020. godine'."@sr;
                              :hasDocumentStatus  vip:published;
                              :hasDocumentType    vip:newsArticle;
                              :hasDocumentURL     <https://nova.rs/vesti/politika/svi-poslovi-brata-ane-brnabic-od-grcicevog-eps-a-20-miliona-evra/>
                            ];
        :hasEconomicOrganizationParticipant
                rs:Asseco_SEE;
        :hasWorkRole        :director;
        bio:participant     rs:Igor_Brnabic , rs:Asseco_SEE;
        owl:differentFrom   rs:Asseco_SEE , rs:Igor_Brnabic .

rs:MihailoJovanovic_KancelarijaIT_Direktor_2024
        rdf:type              :SourcedEntity , bio:Relationship , :Connection , :WorkConnection;
        rdfs:comment          "Vlada je 29. avgusta 2024. izabrala Mihaila Jovanovića za v. d. direktora Kancelarije, na predlog predsednika Vlade Miloša Vučevića (Novosti); sajt Kancelarije, pročitan 12. novembra 2026, navodi ga kao direktora i kaže da je tu funkciju obavljao u dva navrata. Kraj nije zabeležen: to je poslednje dokumentovano stanje, ne dokaz da funkcija traje."@sr , "On 29 August 2024 the Government appointed him acting director of the Office, on the proposal of Prime Minister Miloš Vučević (Novosti); the Office's site, read on 12 November 2026, names him as its director and says he has held the post twice. No end is recorded: that is the latest documented state, not proof that the office continues."@en;
        :connectionStartDate  "2024-08-29"^^xsd:date;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Sajt Kancelarije, strana 'Direktor' (pročitano 12. novembra 2026): 'dr Mihailo Jovanović, direktor Kancelarije za IT i eUpravu'; 'čiji je direktor u dva navrata'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <https://www.ite.gov.rs/tekst/sr/150/direktor.php>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Novosti, 29. avgust 2024: 'na današnjoj sednici Vlade dr Mihailo Jovanović izabran je za v. d. direktora Kancelarije'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.novosti.rs/vesti/politika/1403964/predlog-premijera-vucevica-mihailo-jovanovic-novi-direktor-kancelarije-eupravu>
                              ];
        :hasEconomicOrganizationParticipant
                rs:Kancelarija_za_IT_i_eUpravu;
        :hasWorkRole          :director;
        bio:participant       rs:Kancelarija_za_IT_i_eUpravu , rs:Mihailo_Jovanovic;
        owl:differentFrom     rs:Mihailo_Jovanovic , rs:Kancelarija_za_IT_i_eUpravu .

rs:Predrag_Mali  rdf:type  foaf:Agent , foaf:Person;
        rdfs:comment       "Younger brother of Siniša Mali, per KRIK and per Siniša Mali himself (Globus, 2014, as relayed by KRIK). KRIK reports he directed his brother's firm Oli Consulting from 2005 to 2013 and the family firm Kompost grup, and sat on the board of KK Crvena zvezda in 2014; those roles are not recorded here as connections."@en , "Mlađi brat Siniše Malog, prema KRIK-u i prema samom Siniši Malom (Globus, 2014, preneo KRIK). KRIK navodi da je bio direktor bratovljeve firme Oli Consulting od 2005. do 2013, direktor porodične firme Kompost grup i 2014. član Upravnog odbora KK Crvena zvezda; te uloge ovde nisu zabeležene kao veze."@sr;
        :firstLastName     "Mali";
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "KRIK, 22. jul 2019: 'Predrag Mali, rođeni brat ministra finansija Siniše Malog'; Siniša Mali za Globus 2014, kako prenosi KRIK: 'moj mlađi brat Predrag'."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.krik.rs/koruptivne-veze-milenijum-tim-ustupio-audi-i-stan-bratu-sinise-malog/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "N1 (Beta, KRIK), 22. jul 2019: 'Rođeni brat ministra finansija Siniše Malog Predrag Mali'; prenosi KRIK, nije nezavisna potvrda."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://n1info.rs/vesti/a501712-Milenijum-tim-ustupio-audi-i-stan-bratu-Sinise-Malog/>
                           ];
        foaf:familyName    "Mali";
        foaf:firstName     "Predrag";
        foaf:name          "Predrag Mali"@sr .

