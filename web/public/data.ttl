        vip:ownershipShare  50.0 .

rs:Service_for_Efficient_Energy
        rdf:type           foaf:Organization , foaf:Agent , :Company;
        rdfs:comment       "Ofšor kompanija sa Britanskih Devičanskih Ostrva koju je Novica Tončev osnovao 2010, prema KRIK-u i Vijestima. Postala je neaktivna 2013. i ugašena 2020. Tončev je posle početnog negiranja priznao vlasništvo, ali je rekao da firma nije poslovala."@sr , "British Virgin Islands offshore company established by Novica Tončev in 2010, according to KRIK and Vijesti. It became inactive in 2013 and was dissolved in 2020. After initially denying involvement, Tončev acknowledged ownership but said the company never traded."@en;
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Vijesti prenose KRIK: 'Service for Efficient Energy', osnovana 2010, neaktivna od 2013. i ugašena 2020."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.vijesti.me/svijet/balkan/569829/pandorini-papiri-firma-koje-se-niko-ne-sjeca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "KRIK: 'Service for Efficient Energy', firma sa Britanskih Devičanskih Ostrva; navodi osnivanje 2010, neaktivnost od 2013. i gašenje 2020."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.krik.rs/firma-koje-se-niko-ne-seca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura/>
                           ];
        foaf:name          "Service for Efficient Energy"@sr .

