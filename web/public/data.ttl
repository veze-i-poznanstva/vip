rs:PredragMali_AndrejVucic_Schoolmates
        rdf:type           bio:Relationship , :SocialConnection , :Connection , vip:Schoolmate , :SourcedEntity;
        rdfs:comment       "Tri redakcije opisuju Predraga Malog i Andreja Vučića kao školske drugove: Vreme 2014 („stari školski drugari“), Danas 2016 („njegov školski drug“) i Nova.rs 2021 („školski drug“), sve u izveštajima o incidentu na Paradi ponosa 2014. Nijedna ne navodi školu, razred ni godine, niti izjavu bilo kog od njih dvojice; zato je veza zabeležena kao školsko drugarstvo bez škole, ne kao isti razred (:Classmate). Andrej Vučić je rođen 1972; godina rođenja Predraga Malog ovde nije zabeležena."@sr , "Three newsrooms describe Predrag Mali and Andrej Vučić as schoolmates: Vreme in 2014 (\"old school friends\"), Danas in 2016 (\"his schoolmate\") and Nova.rs in 2021 (\"schoolmate\"), all in reports on the 2014 Pride parade incident. None names the school, class or years, nor quotes either man on it; the tie is therefore recorded as schoolmates without a school, not as the same class (:Classmate). Andrej Vučić was born in 1972; Predrag Mali's birth year is not recorded here."@en;
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Danas, 4. novembar 2016 (Snežana Čongradin, Vuk Jeremić): 'Andrej Vučić i Predrag Mali, njegov školski drug i brat gradonačelnika Beograda Siniše Malog, su pokušali da probiju kordon policije u centru grada.'"@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.danas.rs/vesti/drustvo/cime-se-bavi-andrej-vucic/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Vreme, 1. oktobar 2014 (Slobodan Georgijev): 'njihova su braća Andrej i Predarg – inače stari školski drugari – nabasala sa pripadnicima obezbeđenja srpskog premijera na odred žandarmerije u obezbeđenju Parade ponosa' (ime je u originalu pogrešno otkucano)."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://vreme.com/vreme/u-senci-velikog-brata/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "Nova.rs, 6. oktobar 2021 (Milica Božinović): 'Parada ponosa 2014. centar Beograda i dva brata, Andrej Vučić i Predrag Mali, školski drug i brat tadašnjeg gradonačelnika Beograda Siniše Malog, izvukli su deblji kraj.'"@sr;
