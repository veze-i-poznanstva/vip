rs:NikolaPetrovicEMS_ArkshoreInternational
        rdf:type              :SourcedEntity , vip:OwnershipConnection , :Connection , bio:Relationship;
        rdfs:comment          "KRIK i RSE su 2021. izvestili da je Nikola Petrović bio vlasnik Arkshore International dok je bio direktor EMS-a; KRIK navodi početak 2016. KRIK prenosi potvrdu Agencije da firma nije prijavljena. Petrović nije odgovorio na pitanja novinara. Udeo i datum prestanka vlasništva nisu navedeni; neaktivnost od novembra 2019. ne znači prestanak vlasništva."@sr , "KRIK and RFE/RL reported in 2021 that Nikola Petrović owned Arkshore International while directing EMS; KRIK dates the beginning to 2016. KRIK reports the Agency confirmed the company was not declared. Petrović did not answer journalists’ questions. His share and ownership end date are not stated; inactivity since November 2019 does not mean ownership ended."@en;
        :connectionStartDate  "2016"^^xsd:gYear;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "KRIK: Petrović je bio 'od 2016. godine vlasnik kompanije'; identifikuje Arkshore International LTD."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.krik.rs/barka-predsednikovog-kuma-petrovic-sakrio-ofsor-firmu-i-racun-u-svajcarskoj/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "RSE prenosi KRIK: Petrović je 'bio je vlasnik ofšor (offshore) kompanije'; u istom pasusu imenovana je Arkshore International."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.slobodnaevropa.org/a/krik-petrovic-pandora-papers/31493609.html>
                              ];
        bio:participant       rs:Arkshore_International , rs:Nikola_Petrovic_EMS;
        owl:differentFrom     rs:Arkshore_International , rs:Nikola_Petrovic_EMS;
        vip:ownedCompany      rs:Arkshore_International;
        vip:owner             rs:Nikola_Petrovic_EMS .

rs:CCECCBalkan_Starting_Stanica
        rdf:type              bio:Relationship , :Connection , :SourcedEntity;
        rdfs:comment          "Beogradski ogranak CCECC Balkan angažovao je Starting kao podizvođača za obnovu zgrade stanice u Novom Sadu. Spisak dokumentacije navodi Sporazum br. 209-2021 od 1. novembra 2021. (stavka 421) i Podizvođački ugovor od 20. jula 2022. (stavka 419) između njih. Vreme, prenoseći Forbes, piše da je sporazum potpisan u novembru 2021, a ugovor u julu 2022, i da su strane ušle u podizvođački ugovor 10. novembra 2021; Nova.rs, prenoseći naredbu o sprovođenju istrage, navodi da je Starting ponudu dao po pozivu tog ogranka, a ugovor zaključio 1. novembra 2021. sa konzorcijumom ogranaka CCECCB i „11th China Railway“. Početak je zabeležen na mesec jer se dan razlikuje među izvorima. Spisak opisuje dokumente; sami ugovori nisu pročitani."@sr , "CCECC Balkan's Belgrade branch engaged Starting as subcontractor for the renovation of the Novi Sad station building. The document index lists an Agreement no. 209-2021 dated 1 November 2021 (item 421) and a Subcontract dated 20 July 2022 (item 419) between them. Vreme, relaying Forbes, writes that the agreement was signed in November 2021 and the contract in July 2022, and that the parties entered into the subcontract on 10 November 2021; Nova.rs, relaying the order to conduct an investigation, says that Starting made its offer at that branch's invitation and concluded the contract on 1 November 2021 with a consortium of the branches of CCECCB and \"11th China Railway\". The start is recorded to the month because the day differs between the sources. The index describes documents; the contracts themselves were not read."@en;
        rdfs:label            "podizvođenje obnove stanice"@sr , "station renovation subcontract"@en;
        :connectionStartDate  "2021-11"^^xsd:gYearMonth;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Vreme, 3. januar 2025, prenosi Forbes: 'Kineska kompanija China Civil Engineering Construction Corporation (CCECC) i srpsko privredno društvo Starting potpisale su sporazum i ugovor po kojima je Starting kao podizvođač dobio za posao rekonstrukcije stanične zgrade u Novom Sadu'; 'Sporazum je potpisan u novembru 2021. godine, a ugovor u julu 2022. godine'; 'ušli u podizvođački ugovor 10. novembra 2021.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://vreme.com/vesti/forbs-kinezi-angazovali-srpsku-firmu-starting-za-renoviranje-zeleznicke-stanice-u-novom-sadu/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Nova.rs, 8. avgust 2025, prenosi naredbu o sprovođenju istrage: 'po pozivu za davanje ponude od privrednog društva „China Civil Engineering Constuction Corporation Balkan – Ogranak Beograd“'; 'zaključio ugovor 1. novembra 2021.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://nova.rs/vesti/biznis/firma-starting-postavila-novog-direktora-nakon-hapsenja-nikole-trivica>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Spisak objavljene dokumentacije (mss.jt.rs, PDF izrađen 27. januara 2025; prema 021.rs i Vremenu, dokumentaciju je objavilo Više javno tužilaštvo u Novom Sadu), stavka 421: 'CONSTRUCTION CORPORATION BALKAN OGRANAK BEOGRAD AND PRIVREDNO DRUŠTVO'; 'GRAĐEVINSKO-ZANATSKE RADOVE I INŽENJERING STARTING DOO BEOGRAD (ZEMUN)'; 'Број: 209-2021. Датум: 01.11.2021.'; stavka 419: 'Subcontract for Novi Sad Staton Renovaton Project Works.'; 'CCECC Balkan NO. 27. Date: 20.7.2022.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:officialDocument;
                                :hasDocumentURL     <https://mss.jt.rs/wp-content/uploads/2025/01/%D0%A1%D0%BF%D0%B8%D1%81%D0%B0%D0%BA-%D0%BE%D0%B1%D1%98%D0%B0%D0%B2%D1%99%D0%B5%D0%BD%D0%B5-%D0%B4%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D1%86%D0%B8%D1%98%D0%B5-1.pdf>
                              ];
        bio:participant       rs:CCECC_Balkan_Ogranak_Beograd , rs:Starting;
        owl:differentFrom     rs:CCECC_Balkan_Ogranak_Beograd , rs:Starting .

