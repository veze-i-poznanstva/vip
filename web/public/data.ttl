rs:DarkoTamindzic_ServiceForEfficientEnergy_Formation
        rdf:type              bio:Relationship , :Connection , :SourcedEntity;
        rdfs:comment          "Tončev je KRIK-u rekao da je Darko Tamindžić organizovao osnivanje kompanije i obezbedio ljude koji su mu pomogli; Vijesti prenose taj iskaz. Tamindžićev advokat je potvrdio da zna za postojanje firme, navodeći da po njegovim saznanjima nije aktivno radila. Veza beleži pripisanu pomoć pri osnivanju, ne vlasništvo."@sr , "Tončev told KRIK that Darko Tamindžić arranged the company’s formation and supplied people to help; Vijesti republished this account. Tamindžić’s lawyer acknowledged knowing the company existed and said it had not actively traded to his knowledge. This records attributed formation assistance, not ownership."@en;
        rdfs:label            "Formation assistance"@en , "Pomoć pri osnivanju"@sr;
        :connectionEndDate    "2010"^^xsd:gYear;
        :connectionStartDate  "2010"^^xsd:gYear;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Tončev za KRIK: 'Darko mi je registrovao firmu'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.krik.rs/firma-koje-se-niko-ne-seca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Vijesti prenose Tončevljev iskaz KRIK-u: 'Darko mi je registrovao firmu'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.vijesti.me/svijet/balkan/569829/pandorini-papiri-firma-koje-se-niko-ne-sjeca-otkriva-veze-tonceva-i-srpskog-biznismena-iz-singapura>
                              ];
        bio:participant       rs:Service_for_Efficient_Energy , rs:Darko_Tamindzic;
        owl:differentFrom     rs:Service_for_Efficient_Energy , rs:Darko_Tamindzic .

rs:KancelarijaIT_VladaSrbije_SluzbaVlade
        rdf:type              :Connection , bio:Relationship , :SourcedEntity;
        rdfs:comment          "Kancelarija je obrazovana kao služba Vlade 5. avgusta 2017. (sajt Kancelarije); Vlada ju je najavila kao centralnu funkciju u Vladi koja direktno odgovara premijeru (N1, prenosi Betu); Danas navodi rešenje o imenovanju njenog direktora: odgovoran je Vladi i predsedniku Vlade. Kraj nije zabeležen: sajt Kancelarije navodi da danas nastavlja rad kao posebna organizacija, bez datuma."@sr , "The Office was formed as a service of the Government on 5 August 2017 (the Office's site); the Government announced it as a central function in the Government that answers directly to the Prime Minister (N1 carrying Beta); Danas quotes the decision appointing its director: he answers to the Government and the Prime Minister. No end is recorded: the Office's site says it now continues as a special organisation, without a date."@en;
        rdfs:label            "služba Vlade"@sr , "service of the Government"@en;
        :connectionStartDate  "2017-08-05"^^xsd:date;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "N1, 27. jul 2017, prenosi Betu: 'koja će biti pozicionirana kao centralna funkcija u Vladi, koja direktno odgovara premijeru'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://n1info.rs/vesti/a286708-Osnovana-Kancelarija-za-informacione-tehnologije-i-elektronsku-upravu/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Sajt Kancelarije (pročitano 12. novembra 2026): 'Kancelarija za informacione tehnologije i elektronsku upravu obrazovana kao služba Vlade dana 05.08.2017. godine'; 'nastavlja rad kao posebna organizacija'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:webPage;
                                :hasDocumentURL     <https://www.ite.gov.rs/tekst/sr/149/kancelarija-za-it-i-eupravu.php>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Danas, 26. septembar 2020: 'za direktora kancelarije – „odgovoran je Vladi i predsedniku Vlade“'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.danas.rs/vesti/ekonomija/ugovori-aseka-s-18-miliona-evra-skocili-na-16-miliona/>
                              ];
        bio:participant       rs:Vlada_Srbije , rs:Kancelarija_za_IT_i_eUpravu;
        owl:differentFrom     rs:Vlada_Srbije , rs:Kancelarija_za_IT_i_eUpravu .

