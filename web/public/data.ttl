                             :hasDocumentURL     <https://www.nedeljnik.rs/od-trgovine-na-malo-do-rekonstrukcije-zeleznicke-stanice-u-roku-od-tri-godine-ko-je-firma-koja-se-spomenjinje-u-izvestaju-vestaka-ftn/>
                           ];
        :hasDocumentation  [ rdf:type            :RelatedData , :Documentation;
                             rdfs:comment        "BBC na srpskom, objavljeno 1. avgusta 2025: 'Nenad Ignjatović, vlasnik „Deko tim\"'."@sr;
                             :hasDocumentStatus  vip:published;
                             :hasDocumentType    vip:newsArticle;
                             :hasDocumentURL     <https://www.bbc.com/serbian/articles/cn47xjzq395o/lat>
                           ];
        bio:participant    rs:Nenad_Ignjatovic_Deko_Tim , rs:Deko_Tim;
        owl:differentFrom  rs:Deko_Tim , rs:Nenad_Ignjatovic_Deko_Tim;
