rs:Starting_BobNoviSad_Stanica
        rdf:type              :SourcedEntity , bio:Relationship , :Connection;
        rdfs:comment          "Starting engaged Bob for aluminium joinery and metalwork on the station, including the skylight of the canopy over the entrance to wing B (021.rs, from the contract published by the Higher Public Prosecutor's Office in Novi Sad; 021.rs says the contract was concluded in July 2022). The index (item 503) gives Starting's number dated 28 July 2022 and Bob's dated 3 August 2022; the start is recorded to the year because the two dates differ."@en , "Starting je angažovao firmu Bob za aluminarske i bravarske radove na stanici, uključujući svetlarnik nadstrešnice nad ulazom u krilo B (021.rs, prema ugovoru koji je objavilo Više javno tužilaštvo u Novom Sadu; 021.rs piše da je ugovor zaključen u julu 2022). Spisak (stavka 503) navodi broj Startinga od 28. jula 2022. i broj firme Bob od 3. avgusta 2022; početak je zabeležen na godinu jer se ta dva datuma razlikuju."@sr;
        rdfs:label            "station renovation subcontract"@en , "podizvođenje obnove stanice"@sr;
        :connectionStartDate  "2022"^^xsd:gYear;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "021.rs, 27. januar 2025: 'ugovor podizvođača, firme Starting sa firmom Bob doo iz Novog Sada'; 'Ugovor koji je zaključen u julu 2022. godine'; 'svetlarnik nadstrešnice nad ulazom u krilo B'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.021.rs/novi-sad/vesti/400000/objavljen-ugovor-startinga-sa-jos-jednim-podizvodjacem-ko-je-postavljao-staklo-na-nadstresnicu>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Spisak objavljene dokumentacije (mss.jt.rs, PDF izrađen 27. januara 2025; prema 021.rs i Vremenu, dokumentaciju je objavilo Više javno tužilaštvo u Novom Sadu), stavka 503: '(Број: 104-2022, дана 28.07.2022.) и БОБ д.о.о. (Број 75-2022, дана 03.08.2022.).'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:officialDocument;
                                :hasDocumentURL     <https://mss.jt.rs/wp-content/uploads/2025/01/%D0%A1%D0%BF%D0%B8%D1%81%D0%B0%D0%BA-%D0%BE%D0%B1%D1%98%D0%B0%D0%B2%D1%99%D0%B5%D0%BD%D0%B5-%D0%B4%D0%BE%D0%BA%D1%83%D0%BC%D0%B5%D0%BD%D1%82%D0%B0%D1%86%D0%B8%D1%98%D0%B5-1.pdf>
                              ];
        bio:participant       rs:Bob_Novi_Sad , rs:Starting;
        owl:differentFrom     rs:Bob_Novi_Sad , rs:Starting .

