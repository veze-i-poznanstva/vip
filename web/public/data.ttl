rs:AnaBrnabic_NALED_Osnivanje
        rdf:type              :Connection , :SourcedEntity , bio:Relationship;
        rdfs:comment          "Ana Brnabić je učestvovala u osnivanju NALED-a 2006. godine; N1 navodi da je to bilo u svojstvu višeg koordinatora USAID-ovog programa za ekonomski razvoj opština. Radio Slobodna Evropa prenosi biografiju sa sajta Vlade. Izvori govore o učešću u osnivanju, ne o zaposlenju u NALED-u; osnivanje je događaj iz 2006, pa veza počinje i završava se te godine."@sr , "Ana Brnabić took part in founding NALED in 2006; N1 says she did so as senior coordinator of USAID's Municipal Economic Growth programme. Radio Slobodna Evropa relays the biography on the Government's site. The sources speak of taking part in the founding, not of a job at NALED; the founding is an event of 2006, so the connection starts and ends in that year."@en;
        rdfs:label            "took part in the founding"@en , "učešće u osnivanju"@sr;
        :connectionEndDate    "2006"^^xsd:gYear;
        :connectionStartDate  "2006"^^xsd:gYear;
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "N1, 15. jun 2017: 'Aktivno je učestvovala u osnivanju Nacionalne alijanse za lokalni ekonomski razvoj (NALED) kao viši koordinator USAID-ovog programa za ekonomski razvoj opština'."@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://n1info.rs/vesti/a276314-Ana-Brnabic-nova-premijerka/>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Radio Slobodna Evropa, 15. jun 2017, prenosi biografiju sa sajta Vlade Srbije: 'Aktivno je učestvovala u osnivanju Nacionalne alijanse za lokalni ekonomski razvoj (NALED) 2006. godine.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.slobodnaevropa.org/a/vucic-mandatar-vlada-srbija/28557169.html>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Vikipedija: 'Активно је учествовала у оснивању Националне алијансе за локални економски развој 2006. године.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:encyclopediaArticle;
                                :hasDocumentURL     <https://sr.wikipedia.org/wiki/Ана_Брнабић>
                              ];
        :hasDocumentation     [ rdf:type            :RelatedData , :Documentation;
                                rdfs:comment        "Kurir, 15. jun 2017, biografija: 'Aktivno učestvuje u osnivanju Nacionalne alijanse za lokalni ekonomski razvoj (NALED) 2006.'"@sr;
                                :hasDocumentStatus  vip:published;
                                :hasDocumentType    vip:newsArticle;
                                :hasDocumentURL     <https://www.kurir.rs/vesti/politika/2864945/ovo-je-biografija-nove-premijerke-ana-brnabic-prva-zena-na-celu-vlade-srbije-u-istoriji>
                              ];
        bio:participant       rs:Ana_Brnabic , rs:NALED;
        owl:differentFrom     rs:Ana_Brnabic , rs:NALED .

